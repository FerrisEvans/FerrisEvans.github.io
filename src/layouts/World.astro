---
import { getLocale, localizePath, t, languageTag } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import 'animal-island-ui/style';
import '../styles/global.css';
import '../styles/island.css';
import '../styles/blog-buttons.css';
import '../styles/world.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import LegacyWorkerRecovery from '../components/LegacyWorkerRecovery.astro';
import { siteFor } from '../data/site';
const SITE = siteFor(locale);
interface Props { title?: string; description?: string; posterVersion: string; }
const { title, description = SITE.description, posterVersion } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(`/island/share.jpg?v=${posterVersion}`, Astro.site);
---
<!doctype html>
<html lang={languageTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {!Astro.url.pathname.includes('/drafts/') && <>
      <link rel="alternate" hreflang="en" href={new URL(localizePath(Astro.url.pathname, 'en'), Astro.site)} />
      <link rel="alternate" hreflang="zh-CN" href={new URL(localizePath(Astro.url.pathname, 'zh'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localizePath(Astro.url.pathname, 'en'), Astro.site)} />
    </>}
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(locale, `${SITE.title} · 林间阅读庭院：书架、花圃与生活在岛上的三位朋友`, `${SITE.title}: a woodland reading garden with books, flowers, and three animal friends`)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" href={localizePath(`/favicon.svg?v=${SITE.brandVersion}`, locale)} />
    <link rel="icon" type="image/png" sizes="32x32" href={localizePath(`/brand/island/favicon-32x32.png?v=${SITE.brandVersion}`, locale)} />
    <link rel="icon" type="image/png" sizes="16x16" href={localizePath(`/brand/island/favicon-16x16.png?v=${SITE.brandVersion}`, locale)} />
    <link rel="apple-touch-icon" sizes="180x180" href={localizePath(`/brand/island/apple-touch-icon.png?v=${SITE.brandVersion}`, locale)} />
    <link rel="manifest" href={localizePath(`/site.webmanifest?v=${SITE.brandVersion}`, locale)} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={localizePath("/rss.xml", locale)} />
    <ThemeInit />
    <LegacyWorkerRecovery />
    <slot name="head" />
  </head>
  <body class="blog-body world-body world-home">
    <a href={localizePath("#main-content", locale)} class="skip-link">{t(locale, "跳到正文")}</a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
