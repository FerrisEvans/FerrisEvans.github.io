---
import 'animal-island-ui/style';
import '../styles/global.css';
import IslandCursor from '../components/IslandCursor.astro';
import '../styles/island.css';
import { SITE } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import LegacyWorkerRecovery from '../components/LegacyWorkerRecovery.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Match the homepage opt-in before external styles finish loading. -->
    <style is:inline>@view-transition { navigation: auto; }</style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(SITE.avatar, Astro.site)} />
    <meta property="og:image:alt" content={`${SITE.author} 的头像，${SITE.title} 博客作者`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(SITE.avatar, Astro.site)} />
    <meta name="twitter:image:alt" content={`${SITE.author} 的头像，${SITE.title} 博客作者`} />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=praxis-island-1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/island/favicon-16x16.png?v=praxis-island-1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/island/favicon-32x32.png?v=praxis-island-1" />
    <link rel="icon" type="image/png" sizes="96x96" href="/brand/island/favicon-96x96.png?v=praxis-island-1" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=praxis-island-1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/island/apple-touch-icon.png?v=praxis-island-1" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <LegacyWorkerRecovery />
    <slot name="head" />
    <script is:inline>
      (function () {
        var stored;
        try { stored = localStorage.getItem('theme'); } catch {}
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="blog-body min-h-screen">
    <IslandCursor />
    <a href="#main-content" class="skip-link">跳到正文</a>
    <Nav />
    <div class="blog-workspace">
    <main id="main-content" tabindex="-1" class="min-w-0 focus:outline-none">
      <slot />
    </main>
    <Footer />
    </div>
    <BackToTop />
    <script is:inline>
      document.addEventListener('keydown', function (event) {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          var input = document.querySelector('.pagefind-ui__search-input');
          if (input) {
            input.focus();
          } else {
            window.location.href = '/search/?focus=1';
          }
        }
      });
    </script>
  </body>
</html>
