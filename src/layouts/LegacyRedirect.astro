---
import { siteFor } from '../data/site';
import '../styles/global.css';
interface Props { to: string; label: string; }
const { to, label } = Astro.props;
const chinese = to.startsWith('/zh/');
const site = siteFor(chinese ? 'zh' : 'en');
const canonical = new URL(to, Astro.site);
---
<!doctype html>
<html lang={chinese ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <title>{label === site.title ? label : `${label} · ${site.title}`}</title>
    <script is:inline define:vars={{ to }}>
      window.location.replace(to + window.location.search + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <style>body { margin:0; padding:48px 24px; background:#f8f8f0; color:#794f27; font:16px/1.8 system-ui,sans-serif; } main { max-width:600px; margin:auto; } h1 { font-size:24px; } a { color:#087f77; }</style>
  </head>
  <body><main><h1>{label}</h1><p>{chinese ? '这个页面有了新的地址。' : 'This page has moved. '}<a href={to}>{chinese ? '继续前往' : 'Continue to '}{label} →</a></p></main></body>
</html>
