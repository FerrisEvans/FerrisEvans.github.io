---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagChip from '../../components/TagChip.astro';
import { getPosts, formatDate, getReadingTime, postUrl, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<Base title={`标签 · ${tag}`}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 font-mono text-xs text-ink-faint dark:text-snow-faint">
      <a href="/" class="hover:text-ink dark:hover:text-snow">首页</a>
      <span>/</span>
      <a href="/tags/" class="hover:text-ink dark:hover:text-snow">标签</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">#{tag}</span>
    </nav>

    <header class="mb-10 flex flex-col justify-between gap-4 surface-card p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">
          TAGGED ARTICLES
        </span>
        <h1 class="mt-1 font-mono text-2xl font-bold sm:text-3xl">#{tag}</h1>
        <p class="mt-1.5 text-sm text-ink-soft dark:text-snow-soft">
          包含标签 <code class="font-mono text-xs text-accent dark:text-accent-dark">#{tag}</code> 的全部技术文章，共 {posts.length} 篇。
        </p>
      </div>
      <a
        href="/tags/"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-line bg-paper px-3.5 py-2 text-xs font-medium text-ink-soft transition-colors hover:border-accent/40 hover:text-ink dark:border-line-dark dark:bg-night dark:text-snow-soft dark:hover:text-snow"
      >
        ← 全部标签
      </a>
    </header>

    <ul class="space-y-3.5">
      {
        posts.map((post) => {
          const url = postUrl(post);
          const minutes = getReadingTime(post);
          return (
            <li>
              <article class="group relative flex flex-col gap-3 surface-card-interactive p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
                <div class="min-w-0 flex-1">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <CategoryBadge category={post.data.category} />
                    <time class="font-mono text-xs text-ink-faint dark:text-snow-faint">{formatDate(post.data.pubDate)}</time>
                    <span class="font-mono text-xs text-ink-faint dark:text-snow-faint">· {minutes} 分钟阅读</span>
                  </div>

                  <h2 class="font-serif text-lg font-bold leading-snug text-ink transition-colors group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark">
                    <a href={url} class="after:absolute after:inset-0 after:z-0">
                      {post.data.title}
                    </a>
                  </h2>

                  {post.data.description && (
                    <p class="mt-1.5 line-clamp-2 text-sm leading-6 text-ink-soft dark:text-snow-soft">
                      {post.data.description}
                    </p>
                  )}

                  {post.data.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {post.data.tags.map((t) => (
                        <TagChip tag={t} />
                      ))}
                    </div>
                  )}
                </div>

                <span class="hidden shrink-0 font-mono text-xs font-semibold text-accent transition-transform group-hover:translate-x-0.5 sm:inline-flex dark:text-accent-dark">
                  阅读 →
                </span>
              </article>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>
