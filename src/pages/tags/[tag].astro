---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getPosts, formatDate, postUrl, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<Base title={`标签 · ${tag}`}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-14">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
      <a href="/tags/" class="transition-colors hover:text-ink dark:hover:text-snow">标签</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">#{tag}</span>
    </nav>
    <header class="mb-10">
      <p class="eyebrow">Tag / 标签</p>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight">#{tag}</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">共 {posts.length} 篇文章。</p>
    </header>
    <ul class="space-y-3">
      {
        posts.map((post) => (
          <li class="group relative rounded-xl border border-line bg-paper-elev p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink/20 dark:border-line-dark dark:bg-night-elev dark:hover:border-white/20 sm:flex sm:items-center sm:justify-between sm:gap-6">
            <div class="min-w-0">
              <h2 class="font-serif text-lg font-bold leading-snug">
                <a href={postUrl(post)} class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent dark:group-hover:text-accent-dark">
                  {post.data.title}
                </a>
              </h2>
              {post.data.description && (
                <p class="mt-1.5 line-clamp-1 text-sm leading-6 text-ink-soft dark:text-snow-soft">{post.data.description}</p>
              )}
              <div class="mt-3">
                <CategoryBadge category={post.data.category} />
              </div>
            </div>
            <time datetime={post.data.pubDate.toISOString()} class="mt-3 block shrink-0 text-sm text-ink-faint dark:text-snow-faint sm:mt-0">
              {formatDate(post.data.pubDate)}
            </time>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
