---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getPosts, formatDate, postUrl, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, list]) => ({
    params: { tag },
    props: { tag, posts: list },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<Base title={`标签 · ${tag}`}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
      <a href="/tags/" class="hover:text-ink dark:hover:text-snow">标签</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">#{tag}</span>
    </nav>
    <header class="mb-10">
      <h1 class="font-serif text-3xl font-bold sm:text-4xl">#{tag}</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">共 {posts.length} 篇文章。</p>
    </header>
    <ul class="space-y-3">
      {
        posts.map((post) => (
          <li>
            <a
              href={postUrl(post)}
              class="group flex flex-col gap-2 rounded-xl border border-line bg-paper-elev p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md dark:border-line-dark dark:bg-night-elev sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="min-w-0">
                <h2 class="font-serif font-bold leading-snug transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="mt-1 line-clamp-1 text-sm text-ink-soft dark:text-snow-soft">{post.data.description}</p>
                )}
                <div class="mt-2">
                  <CategoryBadge category={post.data.category} />
                </div>
              </div>
              <time class="shrink-0 text-sm text-ink-faint dark:text-snow-faint">{formatDate(post.data.pubDate)}</time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
