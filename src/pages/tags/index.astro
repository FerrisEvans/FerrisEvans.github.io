---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="标签">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mb-10 flex flex-col justify-between gap-4 border-b border-line pb-6 sm:flex-row sm:items-end dark:border-line-dark">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent dark:text-accent-dark">
          TOPIC INDEX
        </p>
        <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">标签索引</h1>
        <p class="mt-2 text-sm text-ink-soft dark:text-snow-soft">
          共计 {tags.length} 个技术标签，覆盖各个细分主题与关键词。
        </p>
      </div>

      <div class="relative w-full sm:w-64">
        <input
          id="tag-filter"
          type="search"
          placeholder="筛选标签..."
          aria-label="筛选标签"
          class="w-full rounded-xl border border-line bg-paper-elev px-3.5 py-2 font-mono text-xs text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none dark:border-line-dark dark:bg-night-elev dark:text-snow dark:placeholder:text-snow-faint dark:focus:border-accent-dark"
        />
      </div>
    </header>

    <div class="surface-card p-6 sm:p-8">
      <div id="tag-list" class="flex flex-wrap gap-2.5">
        {
          tags.map(([tag, count]) => {
            const isPopular = count >= 2;
            return (
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                data-tag={tag.toLowerCase()}
                class:list={[
                  'tag-item group inline-flex items-center gap-2 rounded-xl border px-3.5 py-2 transition-all duration-200 hover:-translate-y-0.5',
                  isPopular
                    ? 'border-accent/30 bg-accent/[0.04] hover:border-accent hover:bg-accent/10 dark:border-accent-dark/30 dark:bg-accent-dark/[0.08] dark:hover:border-accent-dark'
                    : 'border-line bg-paper hover:border-accent/40 hover:bg-paper-muted/70 dark:border-line-dark dark:bg-night dark:hover:border-accent-dark/40',
                ]}
              >
                <span class="font-mono text-sm font-medium text-ink transition-colors group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark">
                  #{tag}
                </span>
                <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-paper-muted px-1.5 font-mono text-[11px] font-semibold text-ink-soft dark:bg-night-muted dark:text-snow-soft">
                  {count}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var input = document.getElementById('tag-filter');
      var items = Array.from(document.querySelectorAll('.tag-item'));
      input?.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        items.forEach(function (el) {
          var t = el.getAttribute('data-tag') || '';
          el.classList.toggle('hidden', q !== '' && !t.includes(q));
        });
      });
    })();
  </script>
</Base>
