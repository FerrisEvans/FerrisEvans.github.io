---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="标签">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-14">
    <header class="mb-7">
      <p class="eyebrow">Tags / 主题索引</p>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight">标签</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">共 {tags.length} 个标签，按文章数量排列。</p>
    </header>

    <div class="mb-7 flex sm:justify-end">
      <input
        id="tag-filter"
        type="search"
        placeholder="筛选标签…"
        aria-label="筛选标签"
        class="w-full rounded-xl border border-line bg-paper-elev px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-accent dark:border-line-dark dark:bg-night-elev dark:text-snow dark:placeholder:text-snow-faint dark:focus:border-accent-dark sm:w-64"
      />
    </div>

    <div class="flex flex-wrap gap-2.5">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}/`}
            data-tag={tag.toLowerCase()}
            class="tag-item group inline-flex min-h-10 items-center gap-2 rounded-full border border-line bg-paper-elev px-3.5 py-2 text-sm transition-colors hover:border-accent/40 hover:text-accent dark:border-line-dark dark:bg-night-elev dark:hover:border-accent-dark/40 dark:hover:text-accent-dark"
          >
            <span>#{tag}</span>
            <span class="rounded-full bg-ink/[0.05] px-1.5 py-0.5 font-mono text-[0.625rem] leading-none text-ink-faint dark:bg-white/[0.07] dark:text-snow-faint">{count}</span>
          </a>
        ))
      }
    </div>
    <p id="tag-empty" hidden class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">没有匹配的标签。</p>
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById('tag-filter');
      var empty = document.getElementById('tag-empty');
      var items = Array.from(document.querySelectorAll('.tag-item'));
      input?.addEventListener('input', function () {
        var query = input.value.trim().toLowerCase();
        var visible = 0;
        items.forEach(function (item) {
          var matches = (item.getAttribute('data-tag') || '').includes(query);
          item.hidden = !matches;
          if (matches) visible++;
        });
        if (empty) empty.hidden = visible !== 0;
      });
    })();
  </script>
</Base>
