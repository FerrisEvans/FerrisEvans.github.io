---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import Brand from '../components/Brand.astro';
import CategoryWall from '../components/CategoryWall.astro';
import LofiHero from '../components/LofiHero';
import MagazineToolbar from '../components/MagazineToolbar.astro';
import { categoriesFor, categoriesForWall, SITE, type CategoryDef } from '../data/site';
import { getPosts, type Post } from '../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.pin) ?? posts[0];
  const pageSize = SITE.postsPerPage;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
  const hrefFor = (n: number) => (n === 1 ? '/lofi/' : `/page/${n}/`);
  const categories = categoriesFor(posts.map((post) => post.data.category));
  const categoryCounts = Object.fromEntries(
    categories.map((cat) => [cat.slug, posts.filter((post) => post.data.category === cat.slug).length]),
  );
  return Array.from({ length: lastPage }, (_, i) => {
    const n = i + 1;
    return {
      params: { page: n === 1 ? 'lofi' : `page/${n}` },
      props: {
        featured,
        categories,
        categoryCounts,
        page: {
          data: posts.slice(i * pageSize, (i + 1) * pageSize),
          currentPage: n,
          lastPage,
          url: {
            current: hrefFor(n),
            prev: n > 1 ? hrefFor(n - 1) : undefined,
            next: n < lastPage ? hrefFor(n + 1) : undefined,
          },
        },
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, featured, categories, categoryCounts } = Astro.props as {
  page: { data: Post[]; currentPage: number; lastPage: number; url: { current: string; prev?: string; next?: string } };
  featured: Post;
  categories: CategoryDef[];
  categoryCounts: Record<string, number>;
};
const posts = page.data;
const isFirst = page.currentPage === 1;
const spreadAsides = isFirst ? posts.filter((post) => post.id !== featured?.id).slice(0, 2) : [];
const asideIds = new Set(spreadAsides.map((post) => post.id));
const grid = isFirst ? posts.filter((post) => post.id !== featured?.id && !asideIds.has(post.id)) : posts;
const wallCategories = isFirst ? categoriesForWall(categories, categoryCounts, { emptySlots: true }) : [];
---

<Base>
  {
    isFirst && (
      <header>
        <LofiHero client:load tagline={SITE.tagline} intro={SITE.intro}>
          <span slot="title" class="inline-flex justify-center text-hero-fg" style="--brand-accent: #d6a45f">
            <Brand size="hero" />
          </span>
        </LofiHero>
      </header>
    )
  }
  <div class="mx-auto max-w-7xl px-4 pb-4 sm:px-6">
    <MagazineToolbar primary={isFirst} />

    {
      isFirst && featured && (
        <section aria-labelledby="featured-heading" class="mt-8 sm:mt-10">
          <div class="mb-5 flex items-center gap-4">
            <h2 id="featured-heading" class="eyebrow shrink-0">Featured / 封面</h2>
            <span class="h-px flex-1 bg-line dark:bg-line-dark"></span>
          </div>
          <div class:list={['grid gap-4', spreadAsides.length > 0 && 'md:grid-cols-[minmax(0,1.45fr)_minmax(220px,0.8fr)]']}>
            <PostCard post={featured} variant="featured" />
            {spreadAsides.length > 0 && (
              <div class="grid content-start gap-4">
                {spreadAsides.map((post) => <PostCard post={post} variant="compact" />)}
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      isFirst && wallCategories.length > 0 && (
        <section aria-labelledby="wall-heading" class="mt-10 sm:mt-12">
          <div class="mb-5 flex items-center gap-4">
            <h2 id="wall-heading" class="eyebrow shrink-0">Sections / 栏目</h2>
            <span class="h-px flex-1 bg-line dark:bg-line-dark"></span>
          </div>
          <CategoryWall categories={wallCategories} counts={categoryCounts} />
        </section>
      )
    }

    <section aria-labelledby="latest-heading" class={isFirst ? 'mt-12 sm:mt-16' : 'mt-10'}>
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{isFirst ? 'Latest notes' : 'All notes'}</p>
          <h2 id="latest-heading" class="mt-2 font-serif text-2xl font-bold tracking-tight">
            {isFirst ? '最近更新' : `文章列表 · 第 ${page.currentPage} 页`}
          </h2>
        </div>
        <a href="/explore/" class="hidden items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-accent dark:text-snow-soft dark:hover:text-accent-dark sm:inline-flex">
          索引
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {grid.map((post) => <PostCard post={post} variant="default" />)}
      </div>
    </section>

    <Pagination page={page} />
  </div>
</Base>
