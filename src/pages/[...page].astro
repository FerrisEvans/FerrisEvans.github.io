---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import Icon from '../components/Icon.astro';
import { Card, Title, Divider, type CardProps } from 'animal-island-ui';
import { categoriesFor, SITE, type CategoryDef } from '../data/site';
import { getPosts, type Post } from '../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.pin) ?? posts[0];
  const orderedPosts = featured ? [featured, ...posts.filter(post => post.id !== featured.id)] : posts;
  const tagCounts = new Map<string, number>();
  for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  const popularTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 7);
  const pageSize = SITE.postsPerPage;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
  const hrefFor = (n: number) => (n === 1 ? '/lofi/' : `/page/${n}/`);
  const categories = categoriesFor(posts.map((post) => post.data.category));
  const categoryCounts = Object.fromEntries(
    categories.map((cat) => [cat.slug, posts.filter((post) => post.data.category === cat.slug).length]),
  );
  return Array.from({ length: lastPage }, (_, i) => {
    const n = i + 1;
    return {
      params: { page: n === 1 ? 'lofi' : `page/${n}` },
      props: {
        featured,
        total: posts.length,
        popularTags,
        categories,
        categoryCounts,
        page: {
          data: orderedPosts.slice(i * pageSize, (i + 1) * pageSize),
          currentPage: n,
          lastPage,
          url: {
            current: hrefFor(n),
            prev: n > 1 ? hrefFor(n - 1) : undefined,
            next: n < lastPage ? hrefFor(n + 1) : undefined,
          },
        },
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, featured, categories, categoryCounts, total, popularTags } = Astro.props as {
  page: { data: Post[]; currentPage: number; lastPage: number; url: { current: string; prev?: string; next?: string } };
  total: number;
  popularTags: [string, number][];
  featured: Post;
  categories: CategoryDef[];
  categoryCounts: Record<string, number>;
};
const posts = page.data;
const isFirst = page.currentPage === 1;
const grid = isFirst ? posts.filter((p) => p.id !== featured?.id) : posts;

const categoryIcons: Record<string, string> = { 'programming-language': 'book', 'data-structures': 'layers', 'game-dev': 'game', ai: 'flower' };

const categoryPatterns: CardProps["pattern"][] = ["app-pink", "app-yellow", "app-teal", "purple"];
---
<Base>
  <div class="island-page home-page">
    {isFirst ? <>
      <header class="welcome">
        <div class="hero-confetti hero-confetti-one" aria-hidden="true"><Icon name="flower" size={60} /></div>
        <div class="hero-confetti hero-confetti-two" aria-hidden="true"><Icon name="butterfly" size={50} /></div>
        <div class="hero-friends hero-friends-left" aria-hidden="true"><span class="friend-cloud"></span><Icon name="bear" size={118} /><span class="friend-book"><Icon name="book" size={78} /></span><span class="friend-flower"><Icon name="flower" size={56} /></span></div>
        <div class="welcome-copy"><span class="welcome-label"><Icon name="leaf" size={21} /> {SITE.title} · {SITE.author} 的个人博客</span><h1>{SITE.tagline}</h1><p>读一点，试一点，记下一点点。<br />把每一次小小的发现，种在这里。</p><div class="welcome-actions"><a href="#latest-heading" class="island-button primary"><Icon name="book" size={23} />翻开笔记<Icon name="arrow-right" size={20} /></a><a href="/about/" class="welcome-about">认识 {SITE.author}<Icon name="arrow-right" size={19} /></a></div></div>
        <div class="hero-friends hero-friends-right" aria-hidden="true"><span class="friend-cloud"></span><Icon name="tree" size={130} /><span class="friend-mushroom"><Icon name="mushroom" size={76} /></span><span class="friend-snail"><Icon name="snail" size={66} /></span></div>
      </header>
      <nav class="topic-paths" aria-label="按分类浏览">{categories.map((cat,index) => <a href={`/categories/${cat.slug}/`}><Card pattern={categoryPatterns[index%categoryPatterns.length]} hoverable className="topic-card"><Icon name={categoryIcons[cat.slug] ?? 'book'} size={42} /><span class="topic-copy"><strong>{cat.label}</strong><small>{categoryCounts[cat.slug]} 篇小笔记</small></span><Icon name="arrow-right" size={18} /></Card></a>)}</nav>
      <div class="featured-grid">
        <section aria-label="精选文章">{featured && <PostCard post={featured} featured />}</section>
        <aside aria-labelledby="island-notice-title"><Card pattern="app-yellow" className="island-notice"><div class="notice-heading"><Icon name="coffee" size={45} /><Icon name="heart" size={30} /></div><h2 id="island-notice-title">不着急，坐一会儿。</h2><p>这里有 {total} 篇笔记，<br />也有还在慢慢生长的好奇心。</p><p>编程、游戏和一些新的尝试，<br />都从一个小问题开始。</p><a href="/rss.xml" class="notice-about"><Icon name="rss" size={21} />订阅 {SITE.title} 的新消息<Icon name="arrow-right" size={18} /></a></Card></aside>
      </div>
    </> : <header class="page-header"><p class="island-eyebrow"><Icon name="book" size={26} /> 小岛笔记 · 第 {page.currentPage} 页</p><h1 class="island-heading">继续翻一页。</h1><p class="island-lead">共 {total} 篇笔记，每一篇都是探索留下的小脚印。</p></header>}
    <section class="latest-notes" aria-labelledby="latest-heading">
      <div class="section-top"><h2 id="latest-heading"><Title variant="ribbon" color="app-yellow" size="middle">{isFirst ? '最近写下的' : '更多小笔记'}</Title></h2><a href="/archives/"><Icon name="archive" size={23} />去归档逛逛<Icon name="arrow-right" size={18} /></a></div>
      <div class="notes-grid">{grid.map(post => <PostCard post={post} />)}</div>
      <Pagination page={page} />
    </section>
    <section class="topic-trail" aria-label="热门标签"><Divider type="wave-yellow" /><div class="topic-trail-title"><Icon name="tag" size={26} /><span>跟着兴趣，随意逛逛</span></div><div class="topic-trail-links">{popularTags.map(([tag,count]) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}<small>{count}</small></a>)}<a href="/tags/" class="all-tags">全部标签<Icon name="arrow-right" size={18} /></a></div></section>
  </div>
</Base>
<style>
  .home-page { padding-top:26px; }
  .welcome { position:relative; isolation:isolate; overflow:hidden; display:grid; place-items:center; min-height:350px; padding:44px 180px 48px; border-radius:46px 60px 46px 60px; background:#9ccfb3; text-align:center; }
  .welcome::after { content:''; position:absolute; z-index:-1; width:600px; height:280px; border:2px dashed #e4f0d54d; border-radius:50%; left:50%; top:10%; transform:translateX(-50%) rotate(-8deg); }
  .welcome-copy { position:relative; z-index:2; }
  .welcome-label { display:inline-flex; align-items:center; gap:8px; padding:6px 16px; background:#fff8e3; border-radius:50px; color:#725d42; font-size:12px; font-weight:700; transform:rotate(-2deg); }
  .welcome h1 { margin:19px -30px 16px; font-family:var(--font-display); color:#fff9e9; font-size:clamp(32px,4vw,46px); font-weight:900; line-height:1.5; letter-spacing:.015em; text-shadow:0 3px 0 #6a896b; }
  .welcome p { color:#4d694e; font-size:15px; line-height:1.95; font-weight:600; }
  .welcome-actions { margin-top:24px; display:flex; justify-content:center; align-items:center; gap:22px; }
  .welcome-about { color:#465c3d; font-size:13px; font-weight:700; display:inline-flex; align-items:center; gap:6px; }
  .hero-friends { position:absolute; z-index:1; bottom:42px; width:170px; height:178px; display:grid; place-items:center; }
  .hero-friends-left { left:30px; transform:rotate(-8deg); }
  .hero-friends-right { right:25px; transform:rotate(5deg); }
  .friend-cloud { position:absolute; z-index:-1; inset:5px -8px 0; border-radius:48% 52% 40% 60%; background:#e8f1d8; }
  .friend-book { position:absolute; bottom:-4px; left:42px; transform:rotate(8deg); }
  .friend-flower { position:absolute; left:-6px; bottom:-8px; }
  .friend-mushroom { position:absolute; bottom:-4px; left:-6px; }
  .friend-snail { position:absolute; bottom:-11px; right:-5px; transform:rotate(-8deg); }
  .hero-confetti { position:absolute; top:25px; }
  .hero-confetti-one { left:110px; transform:rotate(16deg); }
  .hero-confetti-two { right:98px; transform:rotate(-15deg); }
  .topic-paths { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin:28px 0 32px; }
  .topic-paths a { min-width:0; }
  .topic-paths :global(.topic-card) { display:flex; align-items:center; gap:12px; height:100%; padding:20px 16px; }
  .topic-copy { display:flex; flex-direction:column; gap:5px; flex:1; }
  .topic-copy strong { font-size:14px; font-weight:700; }
  .topic-copy small { font-size:11px; }
  .featured-grid { display:grid; grid-template-columns:1.8fr 1fr; gap:24px; }
  .featured-grid section { display:flex; min-width:0; }
  .featured-grid section :global(.note-card) { width:100%; }
  .featured-grid :global(.island-notice) { height:100%; padding:26px 30px; display:flex; flex-direction:column; }
  .notice-heading { display:flex; align-items:center; justify-content:space-between; }
  .island-notice h2 { font-size:23px; font-weight:900; margin:16px 0 11px; line-height:1.6; }
  .island-notice p { font-size:14px; line-height:1.9; margin-bottom:12px; }
  .notice-about { display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:13px; font-weight:700; margin-top:auto; padding-top:18px; border-top:2px dashed #e6c67e; }
  .latest-notes { margin-top:46px; }
  .section-top { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:0 10px 30px; }
  .section-top > a { display:inline-flex; align-items:center; gap:7px; font-size:13px; color:var(--color-ink-soft); }
  :global(.dark) .section-top > a { color:var(--color-snow-soft); }
  .notes-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
  .topic-trail { margin-top:35px; }
  .topic-trail-title { display:flex; align-items:center; gap:10px; margin:24px 0 16px; font-size:16px; font-weight:700; }
  .topic-trail-links { display:flex; flex-wrap:wrap; gap:10px; }
  .topic-trail a { display:flex; gap:8px; align-items:center; padding:8px 14px; font-size:13px; background:var(--island-surface); border:1.5px solid var(--island-border); border-radius:50px; }
  .topic-trail small { opacity:.75; font-size:11px; }
  .topic-trail .all-tags { border-color:transparent; background:transparent; }
  @media(max-width:1100px) { .welcome { padding-inline:155px; } .hero-friends { transform:scale(.8); } .hero-friends-left { left:10px; } .hero-friends-right { right:8px; } .topic-paths :global(.topic-card) { gap:8px; padding:18px 12px; } .topic-copy strong { font-size:12px; } }
  @media(max-width:767px) { .home-page { padding-top:20px; } .welcome { min-height:420px; padding:25px 16px 135px; border-radius:32px 40px 32px 40px; } .welcome h1 { font-size:29px; margin:17px 0 11px; } .welcome-label { font-size:10px; padding:5px 12px; } .welcome p { font-size:13px; } .welcome-actions { gap:16px; margin-top:17px; } .welcome-actions .island-button { font-size:12px; padding:10px 17px; min-height:42px; } .welcome-about { font-size:11px; } .hero-friends { transform:scale(.62); bottom:-25px; } .hero-friends-left { left:5px; } .hero-friends-right { right:0; } .hero-confetti { display:none; } .topic-paths { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:22px 0; } .topic-paths :global(.topic-card) { padding:15px 10px; } .topic-paths :global(.topic-card > .island-icon:last-child) { display:none; } .featured-grid { grid-template-columns:1fr; gap:18px; } .featured-grid aside { display:none; } .notes-grid { grid-template-columns:1fr; gap:18px; } .section-top { margin-inline:0; gap:8px; } .section-top > a { font-size:11px; gap:3px; } .section-top > a :global(.island-icon:first-child) { display:none; } }
</style>
