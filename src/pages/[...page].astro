---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { categoriesFor, SITE, type CategoryDef } from '../data/site';
import { getPosts, type Post } from '../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.pin) ?? posts[0];
  const pageSize = SITE.postsPerPage;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
  const hrefFor = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
  const categories = categoriesFor(posts.map((post) => post.data.category));
  const categoryCounts = Object.fromEntries(
    categories.map((cat) => [cat.slug, posts.filter((post) => post.data.category === cat.slug).length]),
  );
  return Array.from({ length: lastPage }, (_, i) => {
    const n = i + 1;
    return {
      params: { page: n === 1 ? undefined : `page/${n}` },
      props: {
        featured,
        categories,
        categoryCounts,
        page: {
          data: posts.slice(i * pageSize, (i + 1) * pageSize),
          currentPage: n,
          lastPage,
          url: {
            current: hrefFor(n),
            prev: n > 1 ? hrefFor(n - 1) : undefined,
            next: n < lastPage ? hrefFor(n + 1) : undefined,
          },
        },
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, featured, categories, categoryCounts } = Astro.props as {
  page: { data: Post[]; currentPage: number; lastPage: number; url: { current: string; prev?: string; next?: string } };
  featured: Post;
  categories: CategoryDef[];
  categoryCounts: Record<string, number>;
};
const posts = page.data;
const isFirst = page.currentPage === 1;
const grid = isFirst ? posts.filter((p) => p.id !== featured?.id) : posts;
---

<Base>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      isFirst && (
        <header class="border-b border-line py-8 dark:border-line-dark sm:py-14">
          <div class="grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_25rem] lg:gap-16">
            <div class="hero-enter">
              <div class="flex items-center gap-4">
                <img
                  src={SITE.avatar}
                  alt={SITE.author}
                  width="56"
                  height="56"
                  class="h-14 w-14 rounded-full border border-line object-cover shadow-sm dark:border-line-dark"
                />
                <div>
                  <p class="eyebrow">Ferris / Personal notes</p>
                  <p class="mt-1.5 text-sm text-ink-soft dark:text-snow-soft">在循环里学习，在实践中校准。</p>
                </div>
              </div>
              <h1 class="mt-6 font-serif text-4xl font-bold tracking-tight sm:text-6xl">
                Mainloop<span class="text-accent dark:text-accent-dark">.</span>
              </h1>
              <p class="mt-4 max-w-2xl font-serif text-lg leading-8 text-ink-soft dark:text-snow-soft sm:text-xl">
                {SITE.tagline}
              </p>
              <p class="mt-3 hidden max-w-xl text-sm leading-7 text-ink-faint dark:text-snow-faint sm:block sm:text-[0.9375rem]">
                {SITE.intro}
              </p>
            </div>

            <nav aria-label="按分类浏览" class="hero-enter hero-enter-delay flex flex-wrap gap-2 lg:grid lg:grid-cols-2 lg:gap-3">
              {categories.map((cat, index) => (
                <a
                  href={`/categories/${cat.slug}/`}
                  class="topic-link group rounded-full border border-line bg-paper-elev px-3.5 py-2 transition-colors hover:border-ink/20 dark:border-line-dark dark:bg-night-elev dark:hover:border-white/20 lg:rounded-xl lg:p-4"
                >
                  <div class="flex items-center gap-2.5">
                    <span class="font-mono text-sm font-semibold" style={`color: ${cat.accent};`}>{cat.mark}</span>
                    <span class="text-sm font-medium">{cat.label}</span>
                  </div>
                  <div class="mt-3 hidden items-center justify-between text-xs text-ink-faint dark:text-snow-faint lg:flex">
                    <span class="font-mono">{String(index + 1).padStart(2, '0')}</span>
                    <span>{categoryCounts[cat.slug]} 篇文章</span>
                  </div>
                </a>
              ))}
            </nav>
          </div>
        </header>
      )
    }

    {
      isFirst && featured && (
        <section aria-labelledby="featured-heading" class="mt-10 sm:mt-12">
          <div class="mb-5 flex items-center gap-4">
            <h2 id="featured-heading" class="eyebrow shrink-0">Featured / 精选文章</h2>
            <span class="h-px flex-1 bg-line dark:bg-line-dark"></span>
          </div>
          <PostCard post={featured} featured />
        </section>
      )
    }

    <section aria-labelledby="latest-heading" class={isFirst ? 'mt-12 sm:mt-16' : 'pt-12'}>
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{isFirst ? 'Latest notes' : 'All notes'}</p>
          <h2 id="latest-heading" class="mt-2 font-serif text-2xl font-bold tracking-tight">
            {isFirst ? '最近更新' : `文章列表 · 第 ${page.currentPage} 页`}
          </h2>
        </div>
        <a href="/archives/" class="hidden items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-accent dark:text-snow-soft dark:hover:text-accent-dark sm:inline-flex">
          查看归档
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {grid.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <Pagination page={page} />
  </div>
</Base>
