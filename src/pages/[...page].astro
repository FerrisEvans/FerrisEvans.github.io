---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import LofiHero from '../components/LofiHero';
import { categoriesFor, SITE, type CategoryDef } from '../data/site';
import { getPosts, type Post } from '../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const featured = posts.find((p) => p.data.pin) ?? posts[0];
  const pageSize = SITE.postsPerPage;
  const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
  const hrefFor = (n: number) => (n === 1 ? '/lofi/' : `/page/${n}/`);
  const categories = categoriesFor(posts.map((post) => post.data.category));
  const categoryCounts = Object.fromEntries(
    categories.map((cat) => [cat.slug, posts.filter((post) => post.data.category === cat.slug).length]),
  );
  return Array.from({ length: lastPage }, (_, i) => {
    const n = i + 1;
    return {
      params: { page: n === 1 ? 'lofi' : `page/${n}` },
      props: {
        featured,
        categories,
        categoryCounts,
        page: {
          data: posts.slice(i * pageSize, (i + 1) * pageSize),
          currentPage: n,
          lastPage,
          url: {
            current: hrefFor(n),
            prev: n > 1 ? hrefFor(n - 1) : undefined,
            next: n < lastPage ? hrefFor(n + 1) : undefined,
          },
        },
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, featured, categories, categoryCounts } = Astro.props as {
  page: { data: Post[]; currentPage: number; lastPage: number; url: { current: string; prev?: string; next?: string } };
  featured: Post;
  categories: CategoryDef[];
  categoryCounts: Record<string, number>;
};
const posts = page.data;
const isFirst = page.currentPage === 1;
const grid = isFirst ? posts.filter((p) => p.id !== featured?.id) : posts;
---

<Base>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    {
      isFirst && (
        <>
          <header class="mt-6 sm:mt-10">
            <LofiHero client:load tagline={SITE.tagline} intro={SITE.intro} />
          </header>
          <nav aria-label="按分类浏览" class="mx-auto mt-8 grid max-w-6xl grid-cols-2 gap-px overflow-hidden border-y border-line bg-line dark:border-line-dark dark:bg-line-dark lg:grid-cols-4">
            {categories.map((cat, index) => (
              <a
                href={`/categories/${cat.slug}/`}
                class="group bg-paper px-4 py-5 transition-colors hover:bg-paper-elev dark:bg-night dark:hover:bg-night-elev sm:px-6"
              >
                <span class="flex items-center justify-between gap-2">
                  <span class="font-mono text-sm font-semibold" style={`color: ${cat.accent};`}>{cat.mark}</span>
                  <span class="font-mono text-[0.625rem] text-ink-faint dark:text-snow-faint">{String(index + 1).padStart(2, '0')}</span>
                </span>
                <span class="mt-4 block font-serif text-base font-medium transition-colors group-hover:text-accent dark:group-hover:text-accent-dark sm:text-lg">{cat.label}</span>
                <span class="mt-1 block text-xs text-ink-faint dark:text-snow-faint">{categoryCounts[cat.slug]} 篇文章</span>
              </a>
            ))}
          </nav>
        </>
      )
    }

    {
      isFirst && featured && (
        <section aria-labelledby="featured-heading" class="mx-auto mt-14 max-w-6xl sm:mt-16">
          <div class="mb-7 flex items-center gap-4">
            <h2 id="featured-heading" class="eyebrow shrink-0">Featured / 精选实践</h2>
            <span class="h-px flex-1 bg-line dark:bg-line-dark"></span>
          </div>
          <PostCard post={featured} featured />
        </section>
      )
    }

    <section aria-labelledby="latest-heading" class={`${isFirst ? 'mt-14 sm:mt-16' : 'pt-12'} mx-auto max-w-6xl`}>
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{isFirst ? 'Latest notes' : 'All notes'}</p>
          <h2 id="latest-heading" class="mt-2 font-serif text-2xl font-semibold tracking-tight">
            {isFirst ? '最近更新' : `文章列表 · 第 ${page.currentPage} 页`}
          </h2>
        </div>
        <a href="/archives/" class="hidden items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-accent dark:text-snow-soft dark:hover:text-accent-dark sm:inline-flex">
          查看归档
          <span aria-hidden="true" class="transition-transform hover:translate-x-0.5">→</span>
        </a>
      </div>
      <div class="divide-y divide-line border-y border-line dark:divide-line-dark dark:border-line-dark">
        {grid.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <div class="mx-auto max-w-6xl">
      <Pagination page={page} />
    </div>
  </div>
</Base>
