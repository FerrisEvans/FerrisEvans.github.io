---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-serif text-8xl font-bold text-ink/15 dark:text-snow/15 sm:text-9xl">404</p>
    <h1 class="mt-4 font-serif text-2xl font-bold sm:text-3xl">这一页走丢了</h1>
    <p class="mt-4 max-w-md text-sm leading-7 text-ink-soft dark:text-snow-soft">
      你访问的页面不存在，或者已经被移动。也许它正在某个循环里等待下一次迭代。
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5 dark:bg-snow dark:text-night"
    >
      回到首页
    </a>
  </section>
</Base>
