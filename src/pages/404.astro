---
import { getLocale, localizePath, t } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base alternates={false} title={t(locale, "页面不存在")}>
  <div class="island-page lost-page">
    <section class="island-panel lost-note">
      <span class="lost-icon"><Icon name="leaf" size={38} /></span>
      <p class="island-eyebrow">A LITTLE DETOUR</p>
      <p class="lost-number" aria-hidden="true">404</p>
      <h1>{t(locale, "这张笔记走丢了")}</h1>
      <p class="lost-description">{t(locale, "你访问的页面不存在，或者已经被移动。")}<br />{t(locale, "沿着下面的小路，继续逛逛吧。")}</p>
      <div class="lost-actions">
        <a href={localizePath("/notes/", locale)} class="back-to-notes blog-button blog-button--primary"><Icon name="book" size={18} />{t(locale, "回到笔记")}</a>
        <a href={localizePath("/search/", locale)} class="blog-button"><Icon name="search" size={18} />{t(locale, "搜索文章")}</a>
      </div>
      <a href={localizePath("/", locale)} class="back-to-room"><Icon name="home" size={15} />{t(locale, "回到首页")}<Icon name="arrow-right" size={14} /></a>
    </section>
  </div>
</Base>

<style>
  .lost-page { max-width:880px; padding-block:60px; }
  .lost-note { padding:48px 24px; text-align:center; }
  .lost-icon { display:grid; place-items:center; width:76px; height:76px; border-radius:26px; background:var(--color-paper-subtle); color:var(--color-accent); margin:0 auto 24px; transform:rotate(-8deg); }
  .lost-number { font-size:100px; line-height:1.2; font-weight:800; letter-spacing:-.07em; color:var(--color-accent); opacity:.25; margin:8px 0; }
  .lost-note h1 { font-size:28px; font-weight:700; }
  .lost-description { margin-top:17px; font-size:13px; line-height:1.9; color:var(--color-ink-soft); }
  .lost-actions { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:28px; }
  .lost-actions a { display:inline-flex; align-items:center; gap:8px; min-height:44px; padding:11px 18px; font-size:13px; }
  .back-to-room { display:inline-flex; align-items:center; gap:7px; margin-top:30px; font-size:11px; color:var(--color-ink-faint); }
  :global(.dark) .lost-icon { background:var(--color-night-subtle); color:var(--color-accent-dark); }
  :global(.dark) .lost-number { color:var(--color-accent-dark); }
  :global(.dark) .lost-description { color:var(--color-snow-soft); }
  :global(.dark) .back-to-room { color:var(--color-snow-faint); }
  @media (max-width:639px) { .lost-page { padding-block:30px; } .lost-note { padding:34px 20px; } .lost-note h1 { font-size:23px; } }
</style>
