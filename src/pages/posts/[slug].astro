---
import { render } from 'astro:content';
import katexStyles from 'katex/dist/katex.min.css?url';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Giscus from '../../components/Giscus.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagChip from '../../components/TagChip.astro';
import { categoryOf, labelFromSlug } from '../../data/site';
import { getPosts, formatDate, postUrl, postSlug, readingTime, wordCount, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const series = posts
      .filter((candidate) =>
        candidate.data.category === post.data.category &&
        (candidate.data.subcategory ?? '') === (post.data.subcategory ?? ''))
      .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
    const related = posts
      .filter((candidate) => candidate.id !== post.id && candidate.data.category === post.data.category)
      .slice(0, 3);
    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        older: posts[i + 1] ?? null,
        newer: posts[i - 1] ?? null,
        series,
        related,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post, older, newer, series, related } = Astro.props as {
  post: Post;
  older: Post | null;
  newer: Post | null;
  series: Post[];
  related: Post[];
};
const { Content, headings } = await render(post);
const cat = categoryOf(post.data.category);
const sub = post.data.subcategory
  ? (cat.subcategories[post.data.subcategory] ?? labelFromSlug(post.data.subcategory))
  : undefined;
const seriesLabel = sub ?? cat.label;
const seriesIndex = series.findIndex((item) => item.id === post.id) + 1;
const readingMinutes = readingTime(post);
const words = wordCount(post);
const hasToc = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
const tocCount = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length;

---

<Base title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    {post.data.math && <link rel="stylesheet" href={katexStyles} />}
  </Fragment>
  <div id="read-progress" class="fixed left-0 top-0 z-50 h-0.5 bg-accent dark:bg-accent-dark" style="width: 0%" aria-hidden="true"></div>

  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-x-12">
      <header class="page-header min-w-0 p-6 sm:p-8 lg:col-start-1 lg:row-start-1">
        <nav aria-label="面包屑" class="mb-6 flex flex-wrap items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
          <a href="/categories/" class="transition-colors hover:text-ink dark:hover:text-snow">分类</a>
          <span>/</span>
          <a href={`/categories/${cat.slug}/`} class="transition-colors hover:text-ink dark:hover:text-snow">{cat.label}</a>
          {sub && (
            <>
              <span>/</span>
              <span class="text-ink-soft dark:text-snow-soft">{sub}</span>
            </>
          )}
        </nav>
        <h1 class="font-serif text-3xl font-bold leading-tight tracking-tight sm:text-[2.625rem]">{post.data.title}</h1>
        {post.data.description && (
          <p class="mt-5 max-w-2xl text-[0.9375rem] leading-7 text-ink-soft dark:text-snow-soft">
            {post.data.description}
          </p>
        )}
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-ink-faint dark:text-snow-faint">
          <CategoryBadge category={post.data.category} />
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} 分钟阅读 · 约 {words} 字</span>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={post.data.updatedDate.toISOString()}>更新于 {formatDate(post.data.updatedDate)}</time>
            </>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
        )}

        {series.length > 1 && (
          <details class="series-nav mt-7 rounded-xl border border-line bg-paper-elev px-5 py-4 dark:border-line-dark dark:bg-night-elev">
            <summary>
              <span class="text-sm">
                {seriesLabel} 系列
                <span class="ml-2 text-xs font-normal text-ink-faint dark:text-snow-faint">第 {seriesIndex} / {series.length} 篇</span>
              </span>
            </summary>
            <ol class="mt-4 space-y-2.5 border-t border-line pt-4 dark:border-line-dark">
              {series.map((item, index) => (
                <li class="flex items-baseline gap-3 text-sm leading-6">
                  <span class="shrink-0 font-mono text-xs text-ink-faint dark:text-snow-faint">{String(index + 1).padStart(2, '0')}</span>
                  {item.id === post.id ? (
                    <span aria-current="page" class="font-medium text-accent dark:text-accent-dark">{item.data.title}</span>
                  ) : (
                    <a href={postUrl(item)} class="transition-colors hover:text-accent dark:hover:text-accent-dark">{item.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </details>
        )}
      </header>

      <aside data-pagefind-ignore class="min-w-0 lg:col-start-2 lg:row-start-2">
        {hasToc && (
          <>
            <details class="mobile-toc mt-8 rounded-xl border border-line bg-paper-elev px-4 py-3 dark:border-line-dark dark:bg-night-elev lg:hidden">
              <summary class="text-sm">
                本文目录
                <span class="text-xs font-normal text-ink-faint dark:text-snow-faint">{tocCount} 节</span>
              </summary>
              <div class="mt-3 border-t border-line pt-3 dark:border-line-dark">
                <Toc headings={headings} showTitle={false} />
              </div>
            </details>
            <div class="sticky top-24 mt-12 hidden lg:block">
              <div class="toc-scroll max-h-[calc(100vh-7rem)] overflow-y-auto pb-4">
                <Toc headings={headings} />
              </div>
            </div>
          </>
        )}
      </aside>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <div data-pagefind-body class="prose-custom mt-9 lg:mt-12">
          <Content />
        </div>
      </div>

      <footer data-pagefind-ignore class="min-w-0 lg:col-start-1">
        {related.length > 0 && (
          <section aria-labelledby="related-heading" class="mt-16 border-t border-line pt-10 dark:border-line-dark">
            <p class="eyebrow">Related notes</p>
            <h2 id="related-heading" class="mt-2 font-serif text-2xl font-bold tracking-tight">继续阅读</h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
              {related.map((item) => (
                <a href={postUrl(item)} class="group rounded-xl border border-line bg-paper-elev p-4 transition-colors hover:border-accent/40 dark:border-line-dark dark:bg-night-elev dark:hover:border-accent-dark/40">
                  <h3 class="font-serif font-bold leading-6 transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">{item.data.title}</h3>
                  <span class="mt-4 inline-flex items-center gap-1 text-xs text-ink-faint dark:text-snow-faint">
                    阅读文章 <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <nav aria-label="相邻文章" class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            older ? (
              <a href={postUrl(older)} class="prev-next-card">
                <span class="text-xs text-ink-faint dark:text-snow-faint">← 上一篇</span>
                <span class="mt-1.5 font-serif font-bold leading-snug">{older.data.title}</span>
              </a>
            ) : <span />
          }
          {
            newer && (
              <a href={postUrl(newer)} class="prev-next-card sm:text-right">
                <span class="text-xs text-ink-faint dark:text-snow-faint">下一篇 →</span>
                <span class="mt-1.5 font-serif font-bold leading-snug">{newer.data.title}</span>
              </a>
            )
          }
        </nav>

        <Giscus />
      </footer>
    </div>

    <dialog id="image-viewer" class="image-viewer" aria-label="图片预览">
      <button id="image-viewer-close" type="button" class="image-viewer-close" aria-label="关闭图片预览">关闭</button>
      <img id="image-viewer-image" alt="" />
    </dialog>
  </article>
</Base>

<style>
  @reference "../../styles/global.css";

  .prev-next-card {
    @apply flex flex-col rounded-xl border border-line bg-paper-elev p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 dark:border-line-dark dark:bg-night-elev dark:hover:border-accent-dark/40;
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.prose-custom h2[id]:not(.sr-only), .prose-custom h3[id]:not(.sr-only)').forEach(function (heading) {
      if (heading.querySelector('.heading-anchor')) return;
      var anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.setAttribute('href', '#' + heading.id);
      anchor.setAttribute('aria-label', '转到本节');
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });

    document.querySelectorAll('.prose-custom pre').forEach(function (pre) {
      if (pre.parentElement?.classList.contains('code-block')) return;
      var wrapper = document.createElement('div');
      var header = document.createElement('div');
      var language = document.createElement('span');
      var button = document.createElement('button');
      var resetTimer;
      wrapper.className = 'code-block';
      header.className = 'code-block-header';
      language.className = 'code-language';
      language.textContent = pre.getAttribute('data-language') || 'code';
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');
      button.setAttribute('aria-live', 'polite');
      header.append(language, button);
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.append(header, pre);
      button.addEventListener('click', async function () {
        window.clearTimeout(resetTimer);
        try {
          await navigator.clipboard.writeText(pre.innerText);
          button.dataset.copied = 'true';
          button.textContent = '已复制';
        } catch {
          button.dataset.copied = 'false';
          button.textContent = '复制失败';
        }
        resetTimer = window.setTimeout(function () {
          button.dataset.copied = 'false';
          button.textContent = '复制';
        }, 1600);
      });
    });

    var viewer = document.getElementById('image-viewer');
    var viewerImage = document.getElementById('image-viewer-image');
    var viewerClose = document.getElementById('image-viewer-close');
    if (viewer && viewerImage && viewerClose) {
      document.querySelectorAll('.image-zoom').forEach(function (button) {
        button.addEventListener('click', function () {
          var image = button.querySelector('img');
          if (!image) return;
          viewerImage.src = image.currentSrc || image.src;
          viewerImage.alt = image.alt;
          if (!viewer.open) viewer.showModal();
        });
      });
      viewerClose.addEventListener('click', function () { viewer.close(); });
      viewer.addEventListener('click', function (event) {
        if (event.target === viewer) viewer.close();
      });
    }

    var bar = document.getElementById('read-progress');
    var tocLinks = Array.from(document.querySelectorAll('.toc-link'));
    var headingElements = Array.from(document.querySelectorAll('.prose-custom h2[id], .prose-custom h3[id]'));
    var ticking = false;

    function updateReading() {
      var doc = document.documentElement;
      var total = doc.scrollHeight - doc.clientHeight;
      if (bar) {
        var pct = total > 0 ? Math.min(100, (window.scrollY / total) * 100) : 0;
        bar.style.width = pct + '%';
      }
      if (tocLinks.length && headingElements.length) {
        var current = null;
        headingElements.forEach(function (heading) {
          if (heading.getBoundingClientRect().top <= 140) current = heading;
        });
        if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
          current = headingElements[headingElements.length - 1];
        }
        var href = current ? '#' + current.id : '';
        tocLinks.forEach(function (link) {
          var active = link.getAttribute('href') === href;
          link.classList.toggle('active', active);
          if (active) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }
      ticking = false;
    }

    function scheduleUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(updateReading);
        ticking = true;
      }
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    updateReading();
  })();
</script>
