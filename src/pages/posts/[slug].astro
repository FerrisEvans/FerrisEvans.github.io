---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Giscus from '../../components/Giscus.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagChip from '../../components/TagChip.astro';
import { categoryOf, SITE } from '../../data/site';
import { getPosts, formatDate, getReadingTime, getWordCount, postUrl, postSlug, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      older: posts[i + 1] ?? null,
      newer: posts[i - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, older, newer } = Astro.props as { post: Post; older: Post | null; newer: Post | null };
const { Content, headings } = await render(post);
const cat = categoryOf(post.data.category);
const sub = post.data.subcategory ? cat.subcategories[post.data.subcategory] : undefined;
const minutes = getReadingTime(post);
const words = getWordCount(post);

if (post.data.math) {
  await import('katex/dist/katex.min.css');
}
---

<Base title={post.data.title} description={post.data.description}>
  <div id="read-progress" class="fixed left-0 top-0 z-50 h-0.5 bg-accent transition-[width] duration-100 dark:bg-accent-dark" style="width: 0%"></div>

  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="surface-card relative mb-10 overflow-hidden p-6 sm:p-10">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 h-1.5"
        style={`background-image: ${cat.gradient};`}
      />

      <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-2 font-mono text-xs text-ink-faint dark:text-snow-faint">
        <a href="/" class="hover:text-ink dark:hover:text-snow transition-colors">首页</a>
        <span>/</span>
        <a href="/categories/" class="hover:text-ink dark:hover:text-snow transition-colors">分类</a>
        <span>/</span>
        <a href={`/categories/${cat.slug}/`} class="hover:text-ink dark:hover:text-snow transition-colors">{cat.label}</a>
        {sub && (
          <>
            <span>/</span>
            <span class="text-ink-soft dark:text-snow-soft">{sub}</span>
          </>
        )}
      </nav>

      <h1 class="font-serif text-2xl font-bold leading-tight tracking-tight text-ink sm:text-4xl dark:text-snow">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-4 max-w-3xl text-base leading-7 text-ink-soft dark:text-snow-soft">
          {post.data.description}
        </p>
      )}

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-line/70 pt-5 dark:border-line-dark/70">
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-soft dark:text-snow-soft">
          <CategoryBadge category={post.data.category} />
          <span class="inline-flex items-center gap-1.5 font-mono text-ink-faint dark:text-snow-faint">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <time>{formatDate(post.data.pubDate)}</time>
          </span>
          <span class="font-mono text-ink-faint dark:text-snow-faint">·</span>
          <span class="font-mono text-ink-faint dark:text-snow-faint">约 {minutes} 分钟阅读 ({words} 字)</span>
        </div>

        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
        )}
      </div>
    </header>

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-10">
      <div class="min-w-0">
        <div data-pagefind-body class="surface-card p-6 sm:p-10 prose-custom">
          <Content />
        </div>

        <nav data-pagefind-ignore aria-label="上下篇导航" class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            older ? (
              <a href={postUrl(older)} class="prev-next-card group">
                <span class="inline-flex items-center gap-1 font-mono text-xs text-ink-faint dark:text-snow-faint">
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" /></svg>
                  上一篇 · OLDER
                </span>
                <span class="mt-2 font-serif text-base font-bold leading-snug text-ink transition-colors group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark">
                  {older.data.title}
                </span>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )
          }
          {
            newer && (
              <a href={postUrl(newer)} class="prev-next-card group sm:items-end sm:text-right">
                <span class="inline-flex items-center gap-1 font-mono text-xs text-ink-faint dark:text-snow-faint">
                  NEWER · 下一篇
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
                </span>
                <span class="mt-2 font-serif text-base font-bold leading-snug text-ink transition-colors group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark">
                  {newer.data.title}
                </span>
              </a>
            )
          }
        </nav>

        <Giscus />
      </div>

      <aside data-pagefind-ignore class="mt-10 hidden lg:mt-0 lg:block">
        <div class="sticky top-22 space-y-5">
          <Toc headings={headings} />

          <div class="surface-card p-5">
            <div class="flex items-center gap-3">
              <img src={SITE.avatar} alt={SITE.author} class="h-10 w-10 rounded-xl border border-line object-cover dark:border-line-dark" />
              <div>
                <p class="font-serif text-sm font-bold text-ink dark:text-snow">{SITE.author}</p>
                <p class="font-mono text-[11px] text-ink-faint dark:text-snow-faint">{cat.code} · {cat.label}</p>
              </div>
            </div>
            <p class="mt-3 text-xs leading-5 text-ink-soft dark:text-snow-soft">
              {cat.description}
            </p>
            <a
              href={`/categories/${cat.slug}/`}
              class="mt-3.5 inline-flex w-full items-center justify-center gap-1 rounded-lg border border-line bg-paper-muted/60 px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-accent/40 hover:text-accent dark:border-line-dark dark:bg-night-muted/60 dark:text-snow-soft dark:hover:text-accent-dark"
            >
              浏览本分类更多文章 →
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  @reference "../../styles/global.css";

  .prev-next-card {
    @apply flex flex-col rounded-2xl border border-line bg-paper-elev p-5 shadow-2xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md dark:border-line-dark dark:bg-night-elev dark:hover:border-accent-dark/40;
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('read-progress');
    if (bar) {
      var update = function () {
        var doc = document.documentElement;
        var total = doc.scrollHeight - doc.clientHeight;
        var pct = total > 0 ? (doc.scrollTop / total) * 100 : 0;
        bar.style.width = pct + '%';
      };
      document.addEventListener('scroll', update, { passive: true });
      update();
    }

    // Add copy buttons to code blocks
    var blocks = document.querySelectorAll('.prose-custom pre');
    blocks.forEach(function (pre) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'absolute right-3 top-3 rounded-md border border-line/80 bg-paper-elev/90 px-2 py-1 font-mono text-[11px] text-ink-soft opacity-80 backdrop-blur transition-all hover:opacity-100 hover:border-accent/50 hover:text-accent dark:border-line-dark dark:bg-night-elev/90 dark:text-snow-soft dark:hover:text-accent-dark';
      btn.textContent = '复制';
      btn.addEventListener('click', function () {
        var code = pre.querySelector('code');
        if (!code) return;
        navigator.clipboard?.writeText(code.innerText).then(function () {
          btn.textContent = '已复制 ✓';
          setTimeout(function () {
            btn.textContent = '复制';
          }, 1600);
        });
      });
      pre.appendChild(btn);
    });
  })();
</script>
