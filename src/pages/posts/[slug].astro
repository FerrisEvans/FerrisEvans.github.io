---
import { render } from 'astro:content';
import katexStyles from 'katex/dist/katex.min.css?url';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Toc from '../../components/Toc.astro';
import Giscus from '../../components/Giscus.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import TagChip from '../../components/TagChip.astro';
import { SITE, categoryOf, labelFromSlug } from '../../data/site';
import { getPosts, formatDate, postUrl, postSlug, readingTime, wordCount, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const series = posts
      .filter((candidate) =>
        candidate.data.category === post.data.category &&
        (candidate.data.subcategory ?? '') === (post.data.subcategory ?? ''))
      .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
    const related = posts
      .filter((candidate) => candidate.id !== post.id && candidate.data.category === post.data.category)
      .slice(0, 3);
    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        older: posts[i + 1] ?? null,
        newer: posts[i - 1] ?? null,
        series,
        related,
      },
    };
  });
}) satisfies GetStaticPaths;

const { post, older, newer, series, related } = Astro.props as {
  post: Post;
  older: Post | null;
  newer: Post | null;
  series: Post[];
  related: Post[];
};
const { Content, headings } = await render(post);
const cat = categoryOf(post.data.category);
const sub = post.data.subcategory
  ? (cat.subcategories[post.data.subcategory] ?? labelFromSlug(post.data.subcategory))
  : undefined;
const seriesLabel = sub ?? cat.label;
const seriesIndex = series.findIndex((item) => item.id === post.id) + 1;
const readingMinutes = readingTime(post);
const words = wordCount(post);
const hasToc = headings.some((heading) => heading.depth === 2 || heading.depth === 3);
const tocCount = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length;

---

<Base title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    {post.data.math && <link rel="stylesheet" href={katexStyles} />}
  </Fragment>
  <div id="read-progress" class="fixed left-0 top-0 z-50 h-0.5 bg-accent dark:bg-accent-dark" style="width: 0%" aria-hidden="true"></div>

  <div class="island-page reading-page">
    <nav aria-label="面包屑" class="reading-breadcrumb">
      <a href="/lofi/"><Icon name="book" size={16} /> 文章</a>
      <span aria-hidden="true">/</span>
      <a href={`/categories/${cat.slug}/`}>{cat.label}</a>
      {sub && <><span aria-hidden="true">/</span><span>{sub}</span></>}
    </nav>

    <div class:list={["reading-layout", hasToc && "has-bookmarks"]}>
      <article class="island-panel notebook-sheet">
        <header class="notebook-header">
          <div class="notebook-label"><span class="island-eyebrow">一页小笔记</span><Icon name="leaf" size={24} /></div>
          <h1>{post.data.title}</h1>
          {post.data.description && <p class="notebook-description">{post.data.description}</p>}
          <div class="notebook-meta">
            <a href="/about/" rel="author"><Icon name="user" size={15} />作者：{SITE.author}</a>
            <span><Icon name="calendar" size={15} /><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>
            <span><Icon name="clock" size={15} />{readingMinutes} 分钟 · 约 {words} 字</span>
            {post.data.updatedDate && <span><time datetime={post.data.updatedDate.toISOString()}>更新于 {formatDate(post.data.updatedDate)}</time></span>}
          </div>
          <div class="notebook-topics">
            <CategoryBadge category={post.data.category} />
            {post.data.tags.map((tag) => <TagChip tag={tag} />)}
          </div>
          <a href="#comments" class="comments-jump"><Icon name="message" size={16} />参与讨论<Icon name="arrow-right" size={14} /></a>

          {series.length > 1 && (
            <details class="series-nav notebook-series">
              <summary>
                <span class="series-heading"><Icon name="layers" size={18} />{seriesLabel} 系列</span>
                <span class="series-count">第 {seriesIndex} / {series.length} 篇</span>
              </summary>
              <ol>
                {series.map((item, index) => (
                  <li>
                    <span class="series-number">{String(index + 1).padStart(2, '0')}</span>
                    {item.id === post.id ? (
                      <span aria-current="page" class="series-current">{item.data.title}</span>
                    ) : <a href={postUrl(item)}>{item.data.title}</a>}
                  </li>
                ))}
              </ol>
            </details>
          )}
          {hasToc && (
            <details data-pagefind-ignore class="mobile-toc notebook-mobile-toc">
              <summary><span>本文目录</span><span>{tocCount} 节</span></summary>
              <div class="mobile-toc-content"><Toc headings={headings} showTitle={false} /></div>
            </details>
          )}
        </header>

        <div data-pagefind-body class="prose-custom notebook-content"><Content /></div>

        <footer data-pagefind-ignore class="notebook-footer">
          {related.length > 0 && (
            <section aria-labelledby="related-heading" class="related-notes">
              <p class="island-eyebrow">KEEP EXPLORING</p>
              <h2 id="related-heading">接着读一篇</h2>
              <div class="related-grid">
                {related.map((item) => (
                  <a href={postUrl(item)}>
                    <Icon name="book" size={20} />
                    <h3>{item.data.title}</h3>
                    <span>阅读笔记 <Icon name="arrow-right" size={16} /></span>
                  </a>
                ))}
              </div>
            </section>
          )}
          <nav aria-label="相邻文章" class="adjacent-notes">
            {older ? (
              <a href={postUrl(older)} class="prev-next-card">
                <span><Icon name="arrow-left" size={16} />上一篇</span>
                <strong>{older.data.title}</strong>
              </a>
            ) : <span />}
            {newer && (
              <a href={postUrl(newer)} class="prev-next-card next-note">
                <span>下一篇<Icon name="arrow-right" size={16} /></span>
                <strong>{newer.data.title}</strong>
              </a>
            )}
          </nav>
          <Giscus />
        </footer>
        <dialog id="image-viewer" class="image-viewer" aria-label="图片预览">
          <button id="image-viewer-close" type="button" class="image-viewer-close" aria-label="关闭图片预览">关闭</button>
          <img id="image-viewer-image" alt="" />
        </dialog>
      </article>

      {hasToc && (
        <aside data-pagefind-ignore class="reading-bookmarks">
          <div class="bookmarks-sticky">
            <div class="toc-scroll"><Toc headings={headings} /></div>
            <a href="#comments" class="bookmark-comments"><Icon name="message" size={16} />讨论与评论<Icon name="arrow-right" size={14} /></a>
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  @reference "../../styles/global.css";
  .reading-page { max-width:1280px; }
  .reading-breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:24px; font-size:12px; color:var(--color-ink-faint); }
  .reading-breadcrumb a { display:inline-flex; align-items:center; gap:7px; }
  .reading-breadcrumb a:hover { color:var(--color-accent); }
  .reading-layout { display:grid; grid-template-columns:minmax(0,1fr); gap:24px; align-items:start; }
  .notebook-sheet { min-width:0; width:100%; max-width:880px; margin-inline:auto; padding:38px 40px 30px; }
  .notebook-label { display:flex; align-items:center; justify-content:space-between; color:var(--color-accent); gap:16px; }
  .notebook-header h1 { font-size:clamp(1.8rem,3vw,2.65rem); font-weight:750; line-height:1.35; letter-spacing:.01em; margin:20px 0 18px; overflow-wrap:anywhere; }
  .notebook-description { font-size:15px; line-height:1.9; color:var(--color-ink-soft); }
  .notebook-meta { display:flex; flex-wrap:wrap; align-items:center; gap:10px 18px; margin-top:24px; font-size:11px; color:var(--color-ink-faint); }
  .notebook-meta > span, .notebook-meta > a { display:inline-flex; align-items:center; gap:6px; }
  .notebook-topics { display:flex; flex-wrap:wrap; gap:9px; margin-top:18px; }
  .comments-jump { display:inline-flex; align-items:center; gap:7px; margin-top:20px; font-size:12px; color:var(--color-accent); }
  .notebook-series { border:1px solid var(--color-line); background:var(--color-paper-subtle); padding:16px 18px; border-radius:16px; margin-top:28px; }
  .notebook-series summary { font-size:13px; gap:8px; }
  .series-heading { display:flex; align-items:center; gap:8px; }
  .series-count { margin-left:auto; font-size:11px; color:var(--color-ink-faint); }
  .notebook-series ol { margin-top:16px; padding-top:16px; border-top:1px dashed var(--color-line); }
  .notebook-series li { display:flex; align-items:baseline; gap:12px; font-size:13px; line-height:1.7; margin-top:10px; }
  .series-number { flex-shrink:0; font-size:10px; font-family:var(--font-sans); color:var(--color-ink-faint); }
  .series-current { font-weight:650; color:var(--color-accent); }
  .notebook-series li a:hover { color:var(--color-accent); }
  .notebook-mobile-toc { margin-top:22px; border-block:1px solid var(--color-line); padding-block:16px; }
  .notebook-mobile-toc summary { font-size:13px; }
  .notebook-mobile-toc summary > span:last-child { margin-left:auto; color:var(--color-ink-faint); font-size:11px; }
  .mobile-toc-content { margin-top:16px; }
  .notebook-content { margin-top:36px; padding-top:8px; }
  .notebook-footer { min-width:0; margin-top:52px; }
  .related-notes { border-top:1px dashed var(--color-line); padding-top:30px; }
  .related-notes h2 { font-size:21px; font-weight:700; margin:8px 0 20px; }
  .related-grid { display:grid; gap:12px; }
  .related-grid > a { min-width:0; display:flex; flex-direction:column; align-items:flex-start; gap:12px; border:1px solid var(--color-line); border-radius:16px; padding:17px; background:var(--color-paper); transition:background .15s,transform .15s; }
  .related-grid > a:hover { background:var(--color-paper-subtle); transform:translateY(-2px); }
  .related-grid > a > :global(svg) { color:var(--color-accent); }
  .related-grid h3 { font-size:13px; font-weight:650; line-height:1.7; }
  .related-grid span { display:flex; align-items:center; justify-content:space-between; align-self:stretch; gap:8px; margin-top:auto; font-size:10px; color:var(--color-ink-faint); }
  .adjacent-notes { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:18px; margin-top:30px; padding-block:24px; border-block:1px dashed var(--color-line); }
  .prev-next-card { min-width:0; display:flex; flex-direction:column; align-items:flex-start; gap:9px; }
  .prev-next-card > span { display:flex; align-items:center; gap:7px; font-size:11px; color:var(--color-ink-faint); }
  .prev-next-card strong { font-size:13px; font-weight:600; line-height:1.7; }
  .prev-next-card:hover strong { color:var(--color-accent); }
  .next-note { text-align:right; align-items:flex-end; }
  .reading-bookmarks { display:none; }
  .bookmarks-sticky { position:sticky; top:96px; }
  .toc-scroll { max-height:calc(100vh - 12rem); overflow-y:auto; padding:0 8px 20px 0; }
  .bookmark-comments { display:flex; align-items:center; gap:8px; padding-top:18px; border-top:1px dashed var(--color-line); color:var(--color-ink-faint); font-size:12px; }
  .bookmark-comments > :global(svg:last-child) { margin-left:auto; }
  :global(.dark) .reading-breadcrumb, :global(.dark) .notebook-meta, :global(.dark) .series-count, :global(.dark) .series-number, :global(.dark) .notebook-mobile-toc summary > span:last-child, :global(.dark) .related-grid span, :global(.dark) .prev-next-card > span, :global(.dark) .bookmark-comments { color:var(--color-snow-faint); }
  :global(.dark) .notebook-description { color:var(--color-snow-soft); }
  :global(.dark) .notebook-label, :global(.dark) .comments-jump, :global(.dark) .series-current, :global(.dark) .related-grid > a > :global(svg) { color:var(--color-accent-dark); }
  :global(.dark) .notebook-series { background:var(--color-night-subtle); border-color:var(--color-line-dark); }
  :global(.dark) .notebook-series ol, :global(.dark) .notebook-mobile-toc, :global(.dark) .related-notes, :global(.dark) .adjacent-notes, :global(.dark) .bookmark-comments { border-color:var(--color-line-dark); }
  :global(.dark) .related-grid > a { background:var(--color-night); border-color:var(--color-line-dark); }
  :global(.dark) .related-grid > a:hover { background:var(--color-night-subtle); }
  @media (min-width:640px) { .related-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media (min-width:1440px) { .reading-layout.has-bookmarks { grid-template-columns:minmax(0,880px) 190px; justify-content:center; } .reading-bookmarks { display:block; align-self:stretch; padding-top:30px; } .notebook-mobile-toc { display:none; } }
  @media (max-width:639px) { .notebook-sheet { padding:25px 20px; } .reading-breadcrumb { font-size:11px; gap:8px; } .notebook-header h1 { font-size:26px; } .notebook-description { font-size:14px; } .notebook-series { padding:14px; } .series-heading { gap:6px; } .series-count { font-size:10px; } }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('.prose-custom h2[id]:not(.sr-only), .prose-custom h3[id]:not(.sr-only)').forEach(function (heading) {
      if (heading.querySelector('.heading-anchor')) return;
      var anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.setAttribute('href', '#' + heading.id);
      anchor.setAttribute('aria-label', '转到本节');
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });

    document.querySelectorAll('.prose-custom pre').forEach(function (pre) {
      if (pre.parentElement?.classList.contains('code-block')) return;
      var wrapper = document.createElement('div');
      var header = document.createElement('div');
      var language = document.createElement('span');
      var button = document.createElement('button');
      var resetTimer;
      wrapper.className = 'code-block';
      header.className = 'code-block-header';
      language.className = 'code-language';
      language.textContent = pre.getAttribute('data-language') || 'code';
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');
      button.setAttribute('aria-live', 'polite');
      header.append(language, button);
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.append(header, pre);
      button.addEventListener('click', async function () {
        window.clearTimeout(resetTimer);
        try {
          await navigator.clipboard.writeText(pre.innerText);
          button.dataset.copied = 'true';
          button.textContent = '已复制';
        } catch {
          button.dataset.copied = 'false';
          button.textContent = '复制失败';
        }
        resetTimer = window.setTimeout(function () {
          button.dataset.copied = 'false';
          button.textContent = '复制';
        }, 1600);
      });
    });

    var viewer = document.getElementById('image-viewer');
    var viewerImage = document.getElementById('image-viewer-image');
    var viewerClose = document.getElementById('image-viewer-close');
    if (viewer && viewerImage && viewerClose) {
      document.querySelectorAll('.image-zoom').forEach(function (button) {
        button.addEventListener('click', function () {
          var image = button.querySelector('img');
          if (!image) return;
          viewerImage.src = image.currentSrc || image.src;
          viewerImage.alt = image.alt;
          if (!viewer.open) viewer.showModal();
        });
      });
      viewerClose.addEventListener('click', function () { viewer.close(); });
      viewer.addEventListener('click', function (event) {
        if (event.target === viewer) viewer.close();
      });
    }

    var bar = document.getElementById('read-progress');
    var tocLinks = Array.from(document.querySelectorAll('.toc-link'));
    var headingElements = Array.from(document.querySelectorAll('.prose-custom h2[id], .prose-custom h3[id]'));
    var ticking = false;

    function updateReading() {
      var doc = document.documentElement;
      var total = doc.scrollHeight - doc.clientHeight;
      if (bar) {
        var pct = total > 0 ? Math.min(100, (window.scrollY / total) * 100) : 0;
        bar.style.width = pct + '%';
      }
      if (tocLinks.length && headingElements.length) {
        var current = null;
        headingElements.forEach(function (heading) {
          if (heading.getBoundingClientRect().top <= 140) current = heading;
        });
        if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
          current = headingElements[headingElements.length - 1];
        }
        var href = current ? '#' + current.id : '';
        tocLinks.forEach(function (link) {
          var active = link.getAttribute('href') === href;
          link.classList.toggle('active', active);
          if (active) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }
      ticking = false;
    }

    function scheduleUpdate() {
      if (!ticking) {
        window.requestAnimationFrame(updateReading);
        ticking = true;
      }
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    updateReading();
  })();
</script>
