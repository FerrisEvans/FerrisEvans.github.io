---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { ABOUT, aboutGreeting, aboutInterests } from '../data/room-about';

const interests = aboutInterests();
const principles = ABOUT.principles;
const zen = ABOUT.zen.lines;
---

<Base title="关于">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-14">
    <header class="page-header p-7 sm:p-9">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <img src={SITE.avatar} alt={SITE.author} width="72" height="72" class="h-18 w-18 rounded-full border border-line object-cover shadow-sm dark:border-line-dark" />
        <div>
          <p class="eyebrow">About / 关于</p>
          <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight">{aboutGreeting(SITE.author)}</h1>
          <p class="mt-4 max-w-2xl leading-8 text-ink-soft dark:text-snow-soft">
            {ABOUT.intro}
          </p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center rounded-full bg-ink px-4 text-sm font-medium text-paper transition-colors hover:bg-ink/85 dark:bg-snow dark:text-night dark:hover:bg-snow/85">
              GitHub <span class="ml-1.5" aria-hidden="true">↗</span>
            </a>
            <a href={`mailto:${SITE.email}`} class="inline-flex min-h-10 items-center rounded-full border border-line px-4 text-sm text-ink-soft transition-colors hover:border-ink/20 hover:text-ink dark:border-line-dark dark:text-snow-soft dark:hover:border-white/20 dark:hover:text-snow">
              {SITE.email}
            </a>
          </div>
        </div>
      </div>
    </header>

    <section aria-labelledby="interests-heading" class="mt-10">
      <p class="eyebrow">Interests / 研究方向</p>
      <h2 id="interests-heading" class="sr-only">研究方向</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {interests.map((cat, index) => (
          <a href={`/categories/${cat.slug}/`} class="group rounded-xl border border-line bg-paper-elev p-5 transition-colors hover:border-ink/20 dark:border-line-dark dark:bg-night-elev dark:hover:border-white/20">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-ink-faint dark:text-snow-faint">0{index + 1}</span>
              <span class="font-mono text-sm" style={`color: ${cat.accent};`}>{cat.mark}</span>
            </div>
            <h3 class="mt-4 font-serif text-lg font-bold transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">{cat.label}</h3>
            <p class="mt-2 text-sm leading-6 text-ink-soft dark:text-snow-soft">{cat.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="principles-heading" class="mt-14">
      <p class="eyebrow">Notes to self</p>
      <h2 id="principles-heading" class="mt-2 font-serif text-2xl font-bold tracking-tight">一些相信的事</h2>
      <ol class="mt-5 sm:grid sm:grid-cols-2 sm:gap-x-10">
        {principles.map((principle, index) => (
          <li class="flex gap-4 border-t border-line py-4 dark:border-line-dark">
            <span class="shrink-0 font-mono text-xs leading-7 text-ink-faint dark:text-snow-faint">{String(index + 1).padStart(2, '0')}</span>
            <p class="text-sm leading-7 text-ink-soft dark:text-snow-soft">{principle}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="quotes-heading" class="mt-14">
      <p class="eyebrow">On practice</p>
      <h2 id="quotes-heading" class="mt-2 font-serif text-2xl font-bold tracking-tight">{ABOUT.practice.title}</h2>
      <blockquote class="mt-6 border-l-2 border-accent/50 pl-5 text-[0.9375rem] leading-8 text-ink-soft dark:border-accent-dark/50 dark:text-snow-soft">
        {ABOUT.practice.quotes.map((quote, index) => <p class={index > 0 ? 'mt-4' : undefined}>{quote}</p>)}
        <footer class="mt-4 font-mono text-xs text-ink-faint dark:text-snow-faint">{ABOUT.practice.attribution}</footer>
      </blockquote>
    </section>

    <div class="mt-14 space-y-4">
      <details class="about-disclosure rounded-xl border border-line bg-paper-elev p-5 dark:border-line-dark dark:bg-night-elev">
        <summary>{ABOUT.zen.title} <span class="text-xs font-normal text-ink-faint dark:text-snow-faint">{ABOUT.zen.author}</span></summary>
        <div class="prose-custom mt-5">
          <pre><code class="language-python">{ABOUT.zen.command}</code></pre>
          <ol>{zen.map((line) => <li>{line}</li>)}</ol>
        </div>
      </details>

      <details class="about-disclosure rounded-xl border border-line bg-paper-elev p-5 dark:border-line-dark dark:bg-night-elev">
        <summary>{ABOUT.formatting.title}</summary>
        <div class="prose-custom mt-5">
          {ABOUT.formatting.paragraphs.map((paragraph) => (
            <p>{paragraph.map((part) => {
              const Tag = part.tag ?? 'span';
              return <Tag class={part.accent ? 'text-accent dark:text-accent-dark' : undefined}>{part.text}</Tag>;
            })}</p>
          ))}
        </div>
      </details>
    </div>
  </div>
</Base>
