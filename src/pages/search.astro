---
import Base from '../layouts/Base.astro';

const quickQueries = ['Agent', 'RAG', 'Godot', '指针', 'C++', '链表', '栈', 'GDScript'];
---

<Base title="搜索">
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="mb-8">
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent dark:text-accent-dark">
        FULL-TEXT SEARCH
      </p>
      <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">全站检索</h1>
      <p class="mt-2 text-sm text-ink-soft dark:text-snow-soft">
        通过关键词快速检索全站文章标题、摘要与正文内容。
      </p>
    </header>

    <div class="mb-6 flex flex-wrap items-center gap-2">
      <span class="font-mono text-xs text-ink-faint dark:text-snow-faint">热门检索:</span>
      {
        quickQueries.map((q) => (
          <button
            type="button"
            data-query={q}
            class="quick-query-btn rounded-lg border border-line bg-paper-elev px-2.5 py-1 font-mono text-xs text-ink-soft transition-colors hover:border-accent/40 hover:text-accent dark:border-line-dark dark:bg-night-elev dark:text-snow-soft dark:hover:text-accent-dark"
          >
            {q}
          </button>
        ))
      }
    </div>

    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div class="surface-card p-6 sm:p-8">
      <div id="pagefind-search">
        <p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">
          正在加载搜索引擎…
        </p>
      </div>
    </div>

    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('pagefind-search');
        if (typeof PagefindUI === 'undefined') {
          el.innerHTML =
            '<p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">搜索索引尚未生成。开发模式下没有索引，执行 <code>npm run build</code> 后通过 <code>npm run preview</code> 预览即可使用搜索。</p>';
          return;
        }
        el.innerHTML = '';
        var ui = new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
        var input = el.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.setAttribute('placeholder', '输入关键词搜索文章（如 Agent、指针、Godot）…');
          input.focus();
        }

        document.querySelectorAll('.quick-query-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var q = btn.getAttribute('data-query') || '';
            if (ui && typeof ui.triggerSearch === 'function') {
              ui.triggerSearch(q);
            }
            var searchInput = el.querySelector('.pagefind-ui__search-input');
            if (searchInput) {
              searchInput.value = q;
              searchInput.dispatchEvent(new Event('input', { bubbles: true }));
              searchInput.focus();
            }
          });
        });
      });
    </script>
  </section>
</Base>
