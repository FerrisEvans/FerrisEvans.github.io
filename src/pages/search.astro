---
import Base from '../layouts/Base.astro';

const quickQueries = ['Agent', 'RAG', 'Godot', '指针', 'C++', '链表', '栈', 'GDScript'];
---

<Base title="搜索">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
    <header class="mb-7">
      <p class="eyebrow">Search / 全站搜索</p>
      <h1 class="mt-3 font-serif text-4xl font-bold tracking-tight">搜索</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">搜索全站文章的标题与正文。</p>
      <p class="mt-2 text-xs text-ink-faint dark:text-snow-faint">
        在任意页面按 <kbd class="rounded border border-line px-1.5 py-0.5 font-sans dark:border-line-dark">Ctrl / ⌘ K</kbd> 快速到达这里。
      </p>
    </header>

    <div class="mb-7 flex flex-wrap items-center gap-2">
      <span class="text-xs text-ink-faint dark:text-snow-faint">快捷搜索</span>
      {quickQueries.map((query) => (
        <button
          type="button"
          data-query={query}
          class="quick-query rounded-full border border-line bg-paper-elev px-3 py-1.5 text-xs text-ink-soft transition-colors hover:border-accent/40 hover:text-accent dark:border-line-dark dark:bg-night-elev dark:text-snow-soft dark:hover:border-accent-dark/40 dark:hover:text-accent-dark"
        >
          {query}
        </button>
      ))}
    </div>

    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="pagefind-search" class="min-h-32">
      <p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">
        正在加载搜索…
      </p>
    </div>
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('pagefind-search');
        if (typeof PagefindUI === 'undefined') {
          el.innerHTML =
            '<p class="rounded-xl border border-dashed border-line p-6 text-sm leading-7 text-ink-faint dark:border-line-dark dark:text-snow-faint">开发模式下没有搜索索引。执行 <code>npm run build</code> 后通过 <code>npm run preview</code> 预览即可使用搜索。</p>';
          return;
        }
        el.innerHTML = '';
        new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
        var input = el.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.setAttribute('placeholder', '输入关键词，搜索文章…');
          input.setAttribute('aria-label', '搜索文章');
          var requestedFocus = new URLSearchParams(window.location.search).get('focus') === '1';
          if (requestedFocus && window.matchMedia('(min-width: 768px)').matches) input.focus();
        }
        document.querySelectorAll('.quick-query').forEach(function (button) {
          button.addEventListener('click', function () {
            var searchInput = el.querySelector('.pagefind-ui__search-input');
            if (!searchInput) return;
            searchInput.value = button.getAttribute('data-query') || '';
            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            searchInput.focus();
          });
        });
      });
    </script>
  </div>
</Base>
