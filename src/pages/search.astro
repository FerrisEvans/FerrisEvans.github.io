---
import Base from '../layouts/Base.astro';
---

<Base title="搜索">
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <h1 class="font-serif text-3xl font-bold sm:text-4xl">搜索</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">搜索全站文章的标题与正文。</p>
    </header>

    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="pagefind-search">
      <p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">
        正在加载搜索…
      </p>
    </div>
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('pagefind-search');
        if (typeof PagefindUI === 'undefined') {
          el.innerHTML =
            '<p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-faint dark:border-line-dark dark:text-snow-faint">搜索索引尚未生成。开发模式下没有索引，执行 <code>npm run build</code> 后通过 <code>npm run preview</code> 预览即可使用搜索。</p>';
          return;
        }
        el.innerHTML = '';
        new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
        var input = el.querySelector('.pagefind-ui__search-input');
        if (input) input.setAttribute('placeholder', '搜索文章…');
      });
    </script>
  </section>
</Base>
