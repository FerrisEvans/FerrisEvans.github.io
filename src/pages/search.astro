---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const quickQueries = ['Agent', 'RAG', 'Godot', '指针', 'C++', '链表', '栈', 'GDScript'];
---

<Base title="搜索">
  <div class="island-page search-page">
    <header class="search-heading">
      <span class="search-heading-icon"><Icon name="search" size={31} /></span>
      <p class="island-eyebrow">FIND A LITTLE INSPIRATION</p>
      <h1 class="island-heading">翻找一篇笔记</h1>
      <p class="island-lead">从一个关键词出发，在标题与正文里找找答案。</p>
    </header>
    <div class="island-panel search-panel">
      <div class="search-hint"><span>全站搜索</span><span><kbd>Ctrl / ⌘ K</kbd> 随时开始</span></div>
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <div id="pagefind-search" class="min-h-32"><p class="search-loading">正在打开笔记索引…</p></div>
      <noscript><p class="search-loading">搜索需要启用 JavaScript，也可以<a href="/archives/">按时间浏览全部文章</a>。</p></noscript>
    </div>
    <section aria-labelledby="quick-search-heading" class="search-suggestions">
      <h2 id="quick-search-heading"><Icon name="sparkles" size={17} />试试这些关键词</h2>
      <div class="query-list">
        {quickQueries.map((query) => <button type="button" data-query={query} class="quick-query blog-button">{query}<Icon name="arrow-right" size={13} /></button>)}
      </div>
      <div class="search-alternatives"><span>或者，慢慢逛逛</span><a href="/categories/"><Icon name="grid" size={16} />分类</a><a href="/tags/"><Icon name="tag" size={16} />标签</a><a href="/archives/"><Icon name="archive" size={16} />归档</a></div>
    </section>
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('pagefind-search');
        if (typeof PagefindUI === 'undefined') {
          el.innerHTML =
            '<p class="rounded-xl border border-dashed border-line p-6 text-sm leading-7 text-ink-faint dark:border-line-dark dark:text-snow-faint">开发模式下没有搜索索引。执行 <code>npm run build</code> 后通过 <code>npm run preview</code> 预览即可使用搜索。</p>';
          return;
        }
        el.innerHTML = '';
        new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
        var input = el.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.setAttribute('placeholder', '输入关键词，搜索文章…');
          input.setAttribute('aria-label', '搜索文章');
          var requestedFocus = new URLSearchParams(window.location.search).get('focus') === '1';
          if (requestedFocus && window.matchMedia('(min-width: 768px)').matches) input.focus();
        }
        document.querySelectorAll('.quick-query').forEach(function (button) {
          button.addEventListener('click', function () {
            var searchInput = el.querySelector('.pagefind-ui__search-input');
            if (!searchInput) return;
            searchInput.value = button.getAttribute('data-query') || '';
            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            searchInput.focus();
          });
        });
      });
    </script>

  </div>
</Base>

<style>
  .search-page { max-width:940px; }
  .search-heading { text-align:center; padding:10px 0 32px; }
  .search-heading-icon { display:grid; place-items:center; width:66px; height:66px; border:1px solid var(--color-line); border-radius:23px; background:var(--color-paper-elev); color:var(--color-accent); margin:0 auto 24px; transform:rotate(-6deg); }
  .search-panel { padding:27px 30px; }
  .search-hint { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:11px; color:var(--color-ink-faint); margin-bottom:15px; }
  .search-hint > span:first-child { font-size:12px; font-weight:650; color:var(--color-ink-soft); }
  .search-hint kbd { border:1px solid var(--color-line); background:var(--color-paper); border-radius:6px; font:10px var(--font-sans); padding:3px 6px; margin-right:5px; }
  .search-loading { font-size:13px; line-height:1.8; color:var(--color-ink-faint); padding:22px 0; }
  .search-loading a { text-decoration:underline; text-underline-offset:4px; }
  .search-suggestions { padding:26px 8px 0; }
  .search-suggestions h2 { display:flex; align-items:center; gap:8px; font-size:12px; font-weight:500; color:var(--color-ink-soft); }
  .query-list { display:flex; flex-wrap:wrap; gap:10px; margin-top:15px; }
  .quick-query { display:inline-flex; align-items:center; gap:14px; min-height:38px; padding:8px 14px; font-size:12px; }
  .quick-query > :global(svg) { color:var(--color-ink-faint); }
  .search-alternatives { display:flex; flex-wrap:wrap; align-items:center; gap:17px; margin-top:32px; padding-top:24px; border-top:1px dashed var(--color-line); font-size:11px; color:var(--color-ink-faint); }
  .search-alternatives a { display:flex; align-items:center; gap:6px; color:var(--color-accent); }
  :global(.dark) .search-heading-icon { background:var(--color-night-elev); border-color:var(--color-line-dark); color:var(--color-accent-dark); }
  :global(.dark) .search-hint, :global(.dark) .search-loading, :global(.dark) .quick-query > :global(svg), :global(.dark) .search-alternatives { color:var(--color-snow-faint); }
  :global(.dark) .search-hint > span:first-child, :global(.dark) .search-suggestions h2 { color:var(--color-snow-soft); }
  :global(.dark) .search-hint kbd { background:var(--color-night); border-color:var(--color-line-dark); }
  :global(.dark) .search-alternatives { border-color:var(--color-line-dark); }
  :global(.dark) .search-alternatives a { color:var(--color-accent-dark); }
  @media (max-width:639px) { .search-panel { padding:21px 18px; } .search-hint > span:last-child { font-size:0; } .search-hint kbd { margin:0; } .search-alternatives { gap:14px; } .search-alternatives > span { flex-basis:100%; } }
</style>
