---
import { locales, getLocale, localizePath, t, tagLabel } from '../../../i18n';
export const getStaticPaths = () => locales.map(locale => ({ params: { locale } }));
const locale = getLocale(Astro.url.pathname);
import { Title } from 'animal-island-ui';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import TagWordCloud from '../../../components/TagWordCloud';
import { getPosts } from '../../../utils/posts';

const counts = new Map<string, number>();
for (const post of await getPosts({ locale })) {
  for (const tag of new Set(post.data.tags)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name: tagLabel(name, locale), count, href: localizePath(`/tags/${encodeURIComponent(name)}/`, locale) }));
---
<Base title={t(locale, "标签")}>
  <script is:inline slot="head">
    // Opt in before the SSR list can paint. Without scripts it remains usable.
    (() => {
      const root = document.documentElement;
      root.dataset.tagCloud = 'pending';
      const complete = () => {
        clearTimeout(timeout);
        if (root.dataset.tagCloud === 'pending') root.dataset.tagCloud = 'ready';
      };
      // Failed or very slow bundles must never leave the tags permanently hidden.
      const timeout = setTimeout(() => {
        root.dataset.tagCloud = 'fallback';
        document.removeEventListener('tag-cloud-ready', complete);
      }, 5000);
      document.addEventListener('tag-cloud-ready', complete, { once: true });
    })();
  </script>
  <div class="island-page tags-page">
    <header class="tag-intro">
      <span class="page-decoration"><Icon name="tag" size={52} /></span>
      <h1><Title color="app-yellow" size="large">{t(locale, "标签收集册")}</Title></h1>
      <p class="island-lead">{tags.length} {t(locale, "枚标签，帮你找到感兴趣的笔记。点开一枚，看看里面藏了什么。")}</p>
    </header>
    <TagWordCloud tags={tags} locale={locale} client:load />
    <noscript><style>.tag-tools { display:none; }</style></noscript>
  </div>
</Base>
<style>
  .tag-intro { margin-bottom:30px; text-align:center; }
  .page-decoration { display:inline-flex; color:var(--color-accent); margin-bottom:14px; transform:rotate(9deg); }
  .tag-intro h1 { margin-bottom:22px; }
</style>
