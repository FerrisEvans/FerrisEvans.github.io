---
import { Image } from 'astro:assets';
import aboutAvatar from '../../assets/about-avatar.png';
import { locales, getLocale, localizePath, t } from '../../i18n';
export const getStaticPaths = () => locales.map(locale => ({ params: { locale } }));
const locale = getLocale(Astro.url.pathname);
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import IslandBrand from '../../components/IslandBrand.astro';
import { siteFor } from '../../data/site';
const SITE = siteFor(locale);
import { aboutFor, aboutGreeting } from '../../data/room-about';
import { guidesFor } from '../../data/about-guides';

const ABOUT = aboutFor(locale);
const ABOUT_GUIDES = guidesFor(locale);
const principles = ABOUT.principles;
---

<Base title={t(locale, `关于 ${SITE.author}`, `About ${SITE.author}`)}>
  <div class="island-page about-page">
    <header class="about-title">
      <p class="island-eyebrow">{t(locale, `来自 ${SITE.author} 的一封信`, `A letter from ${SITE.author}`)}</p>
      <h1 class="island-heading">{t(locale, "关于作者与博客", "About the Author and the Blog")}</h1>
      <p class="island-lead"><IslandBrand inline /> {t(locale, `是 ${SITE.author} 的个人博客，一个存放实践、问题和好奇心的地方。`, `is ${SITE.author}’s personal blog—a place for experiments, questions, and curiosity.`)}</p>
    </header>

    <section class="island-panel profile-note" aria-labelledby="profile-heading">
      <div class="profile-photo"><Image src={aboutAvatar} alt={t(locale, `${SITE.author} 的粉发女孩卡通头像`, `${SITE.author}’s cartoon avatar: a pink-haired girl`)} width={112} height={112} densities={[1, 2, 3]} format="webp" quality={90} /></div>
      <div class="profile-copy">
        <h2 id="profile-heading">{aboutGreeting(SITE.author, locale)}</h2>
        <p>{ABOUT.intro}</p>
        <div class="profile-links">
          <a href={localizePath(SITE.github, locale)} target="_blank" rel="noopener noreferrer" class="profile-github blog-button" aria-label={t(locale, `${SITE.author} 的 GitHub`, `${SITE.author} on GitHub`)}><Icon name="github" size={17} />GitHub<Icon name="arrow-right" size={15} /></a>
          <a href={localizePath(`mailto:${SITE.email}`, locale)} aria-label={t(locale, `给 ${SITE.author} 发邮件：${SITE.email}`, `Email ${SITE.author}: ${SITE.email}`)}><Icon name="mail" size={16} /><span>{SITE.email}</span></a>
        </div>
      </div>
    </section>

    <section class="about-guides" aria-labelledby="guides-heading">
      <div class="guide-section-heading"><div><p class="island-eyebrow">{t(locale, "阅读与写作", "Reading and writing")}</p><h2 id="guides-heading">{t(locale, "几份常翻的笔记", "Notes I Return To")}</h2></div><Icon name="book" size={24} /></div>
      <div class="guide-card-grid">
        {ABOUT_GUIDES.map((guide, index) => (
          <a id={guide.id} href={localizePath(guide.href, locale)} class="island-panel guide-card">
            <span class="guide-card-top"><span class="guide-card-icon"><Icon name={guide.icon} size={24} /></span><span class="guide-card-number">0{index + 1}</span></span>
            <span class="guide-card-label">{guide.label}</span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <span class="guide-card-action">{t(locale, "阅读全文", "Read the guide")}<Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </section>

    <div class="about-note-grid">
      <section aria-labelledby="principles-heading" class="island-panel principles-note">
        <p class="island-eyebrow">{t(locale, "记在心里的小事", "Things to keep in mind")}</p>
        <h2 id="principles-heading">{t(locale, "一些相信的事", "A Few Things I Believe")}</h2>
        <ol>{principles.map((principle, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{principle}</p></li>)}</ol>
      </section>
      <section aria-labelledby="quotes-heading" class="island-panel practice-note">
        <Icon name="leaf" size={32} />
        <p class="island-eyebrow">{t(locale, "慢慢实践", "Keep practicing")}</p>
        <h2 id="quotes-heading">{ABOUT.practice.title}</h2>
        <blockquote>
          {ABOUT.practice.quotes.map((quote) => <p>{quote}</p>)}
          <footer>{ABOUT.practice.attribution}</footer>
        </blockquote>
      </section>
    </div>


  </div>
</Base>

<style>
  .about-title { margin-bottom:30px; }
  .profile-note { display:flex; align-items:flex-start; gap:28px; padding:34px; }
  .profile-photo { flex-shrink:0; }
  .profile-photo img { display:block; width:112px; height:112px; object-fit:contain; object-position:center; }
  .profile-copy { min-width:0; }
  .profile-copy h2 { margin:0 0 14px; font-size:24px; font-weight:700; }
  .profile-copy > p { font-size:14px; line-height:1.95; color:var(--color-ink-soft); max-width:640px; }
  .profile-links { display:flex; flex-wrap:wrap; align-items:center; gap:14px 20px; margin-top:22px; }
  .profile-links a { display:inline-flex; align-items:center; gap:8px; font-size:12px; min-width:0; }
  .profile-links a:not(.blog-button) { color:var(--color-ink-soft); }
  .profile-links a span { overflow-wrap:anywhere; }
  .profile-links .profile-github { padding:11px 17px; }
  .profile-links a:not(.blog-button):hover { opacity:.8; }
  .about-note-grid h2 { font-size:22px; font-weight:700; margin-top:7px; color:var(--color-ink); }
  .about-note-grid { display:grid; grid-template-columns:1.1fr 1fr; gap:20px; margin-top:28px; }
  .principles-note, .practice-note { padding:28px; }
  .principles-note ol { display:grid; gap:16px; margin-top:22px; }
  .principles-note li { display:flex; gap:12px; align-items:baseline; font-size:12px; line-height:1.85; }
  .principles-note li > span { font-family:var(--font-sans); font-size:10px; color:var(--color-accent); }
  .practice-note { background:var(--color-paper-subtle); }
  .practice-note > :global(svg) { color:var(--color-accent); margin-bottom:18px; }
  .practice-note blockquote { font-size:13px; line-height:1.95; margin-top:18px; color:var(--color-ink-soft); }
  .practice-note blockquote p + p { margin-top:15px; }
  .practice-note footer { margin-top:18px; font-size:10px; color:var(--color-ink-faint); }
  .about-guides { margin-top:36px; }
  .guide-section-heading { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:18px; color:var(--color-accent); }
  .guide-section-heading h2 { margin-top:7px; font-size:22px; font-weight:700; color:var(--color-ink); }
  .guide-card-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  .guide-card { display:flex; flex-direction:column; align-items:flex-start; min-width:0; padding:26px; scroll-margin-top:110px; transition:transform .15s; }
  .guide-card:hover { transform:translateY(-3px); }
  .guide-card:focus-visible { outline:2px solid var(--color-accent); outline-offset:5px; }
  .guide-card-top { display:flex; width:100%; align-items:center; justify-content:space-between; margin-bottom:22px; }
  .guide-card-icon { display:grid; place-items:center; width:46px; height:46px; border-radius:16px; color:var(--color-accent); background:var(--color-paper-subtle); }
  .guide-card-number { font-size:12px; color:var(--color-ink-faint); }
  .guide-card-label { font-size:10px; color:var(--color-ink-faint); margin-bottom:8px; }
  .guide-card h3 { font-size:17px; line-height:1.5; font-weight:700; margin-bottom:12px; }
  .guide-card p { font-size:12px; line-height:1.9; color:var(--color-ink-soft); margin-bottom:24px; }
  .guide-card-action { display:flex; align-self:stretch; align-items:center; justify-content:space-between; gap:12px; padding-top:17px; margin-top:auto; border-top:1px dashed var(--color-line); font-size:11px; color:var(--color-accent); }
  :global(.dark) .guide-card h3, :global(.dark) .guide-section-heading h2 { color:var(--color-snow); }
  :global(.dark) .guide-section-heading, :global(.dark) .guide-card-icon, :global(.dark) .guide-card-action { color:var(--color-accent-dark); }
  :global(.dark) .guide-card-icon { background:var(--color-night-subtle); }
  :global(.dark) .guide-card p { color:var(--color-snow-soft); }
  :global(.dark) .guide-card-label, :global(.dark) .guide-card-number { color:var(--color-snow-faint); }
  :global(.dark) .guide-card-action { border-color:var(--color-line-dark); }
  @media(prefers-reduced-motion:reduce) { .guide-card { transition:none; } .guide-card:hover { transform:none; } }
  :global(.dark) .profile-copy > p, :global(.dark) .profile-links a:not(.blog-button), :global(.dark) .practice-note blockquote { color:var(--color-snow-soft); }
  :global(.dark) .principles-note li > span, :global(.dark) .practice-note > :global(svg) { color:var(--color-accent-dark); }
  :global(.dark) .about-note-grid h2 { color:var(--color-snow); }
  :global(.dark) .practice-note { background:var(--color-night-subtle); }
  :global(.dark) .practice-note footer { color:var(--color-snow-faint); }
  @media (max-width:800px) { .about-note-grid, .guide-card-grid { grid-template-columns:1fr; } }
  @media (max-width:639px) { .profile-note { flex-direction:column; padding:25px; gap:22px; } .profile-copy h2 { font-size:22px; } .principles-note, .practice-note { padding-inline:23px; } }
</style>
