---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CardCover from '../../components/CardCover.astro';
import TagChip from '../../components/TagChip.astro';
import { CATEGORIES, categoryOf } from '../../data/site';
import { getPosts, formatDate, postUrl, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: posts.filter((p) => p.data.category === cat.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props as { category: (typeof CATEGORIES)[number]; posts: Post[] };

const groups: { label: string; posts: Post[] }[] = [];
const grouped = new Map<string, Post[]>();
for (const post of posts) {
  const key = post.data.subcategory ?? '';
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}
const orderedKeys = [...Object.keys(category.subcategories), ...[...grouped.keys()].filter((k) => !(k in category.subcategories))];
for (const key of orderedKeys) {
  const list = grouped.get(key);
  if (!list?.length) continue;
  groups.push({ label: key ? (category.subcategories[key] ?? key) : '未分组', posts: list });
}
---

<Base title={category.label} description={category.description}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
      <a href="/categories/" class="hover:text-ink dark:hover:text-snow">分类</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">{category.label}</span>
    </nav>

    <header class="mb-10 overflow-hidden rounded-2xl border border-line dark:border-line-dark">
      <CardCover category={category.slug} class="aspect-[21/9] sm:aspect-[3/1]" />
      <div class="bg-paper-elev p-6 dark:bg-night-elev sm:p-8">
        <h1 class="font-serif text-3xl font-bold">{category.label}</h1>
        <p class="mt-2 text-sm text-ink-soft dark:text-snow-soft">{category.description} · 共 {posts.length} 篇</p>
      </div>
    </header>

    {
      groups.map((group) => (
        <section class="mb-12">
          <h2 class="mb-5 flex items-center gap-3 font-serif text-xl font-bold">
            {group.label}
            <span class="text-sm font-normal text-ink-faint dark:text-snow-faint">{group.posts.length} 篇</span>
          </h2>
          <ul class="space-y-3">
            {group.posts.map((post) => (
              <li>
                <a
                  href={postUrl(post)}
                  class="group flex flex-col gap-2 rounded-xl border border-line bg-paper-elev p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md dark:border-line-dark dark:bg-night-elev sm:flex-row sm:items-center sm:justify-between"
                >
                  <div class="min-w-0">
                    <h3 class="font-serif font-bold leading-snug transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="mt-1 line-clamp-1 text-sm text-ink-soft dark:text-snow-soft">{post.data.description}</p>
                    )}
                    {post.data.tags.length > 0 && (
                      <div class="mt-2 flex flex-wrap gap-1.5">
                        {post.data.tags.map((tag) => (
                          <TagChip tag={tag} />
                        ))}
                      </div>
                    )}
                  </div>
                  <time class="shrink-0 text-sm text-ink-faint dark:text-snow-faint">{formatDate(post.data.pubDate)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>
