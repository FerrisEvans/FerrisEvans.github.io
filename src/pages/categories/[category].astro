---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CardCover from '../../components/CardCover.astro';
import TagChip from '../../components/TagChip.astro';
import { categoriesFor, labelFromSlug, type CategoryDef } from '../../data/site';
import { getPosts, formatDate, postUrl, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return categoriesFor(posts.map((post) => post.data.category)).map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: posts.filter((post) => post.data.category === cat.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props as { category: CategoryDef; posts: Post[] };

const groups: { label: string; posts: Post[] }[] = [];
const grouped = new Map<string, Post[]>();
for (const post of posts) {
  const key = post.data.subcategory ?? '';
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}
const orderedKeys = [...Object.keys(category.subcategories), ...[...grouped.keys()].filter((k) => !(k in category.subcategories))];
for (const key of orderedKeys) {
  const list = grouped.get(key);
  if (!list?.length) continue;
  groups.push({ label: key ? (category.subcategories[key] ?? labelFromSlug(key)) : '全部文章', posts: list });
}
---

<Base title={category.label} description={category.description}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-14">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
      <a href="/categories/" class="transition-colors hover:text-ink dark:hover:text-snow">分类</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">{category.label}</span>
    </nav>

    <header class="surface-card mb-12 overflow-hidden">
      <CardCover category={category.slug} class="aspect-[16/9] sm:aspect-[3/1]" />
      <div class="p-6 sm:p-8">
        <p class="eyebrow">Category / 分类</p>
        <h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{category.label}</h1>
        <p class="mt-3 text-sm leading-7 text-ink-soft dark:text-snow-soft">{category.description} · 共 {posts.length} 篇</p>
      </div>
    </header>

    {
      groups.map((group) => (
        <section class="mb-12">
          <h2 class="mb-5 flex items-center gap-3 font-serif text-xl font-bold">
            {group.label}
            <span class="text-sm font-normal text-ink-faint dark:text-snow-faint">{group.posts.length} 篇</span>
          </h2>
          <ul class="space-y-3">
            {group.posts.map((post) => (
              <li class="group relative rounded-xl border border-line bg-paper-elev p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink/20 dark:border-line-dark dark:bg-night-elev dark:hover:border-white/20 sm:flex sm:items-center sm:justify-between sm:gap-6">
                <div class="min-w-0">
                  <h3 class="font-serif text-lg font-bold leading-snug">
                    <a href={postUrl(post)} class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent dark:group-hover:text-accent-dark">
                      {post.data.title}
                    </a>
                  </h3>
                  {post.data.description && (
                    <p class="mt-1.5 line-clamp-1 text-sm leading-6 text-ink-soft dark:text-snow-soft">{post.data.description}</p>
                  )}
                  {post.data.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {post.data.tags.map((tag) => <TagChip tag={tag} />)}
                    </div>
                  )}
                </div>
                <time datetime={post.data.pubDate.toISOString()} class="mt-3 block shrink-0 text-sm text-ink-faint dark:text-snow-faint sm:mt-0">
                  {formatDate(post.data.pubDate)}
                </time>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
