---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostListItem from '../../components/PostListItem.astro';
import { categoriesFor, labelFromSlug } from '../../data/site';
import { getPosts, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return categoriesFor(posts.map((post) => post.data.category)).map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: posts.filter((post) => post.data.category === cat.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props as { category: ReturnType<typeof categoriesFor>[number]; posts: Post[] };

const groups: { label: string; posts: Post[] }[] = [];
const grouped = new Map<string, Post[]>();
for (const post of posts) {
  const key = post.data.subcategory ?? '';
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}
const orderedKeys = [...Object.keys(category.subcategories), ...[...grouped.keys()].filter((k) => !(k in category.subcategories))];
for (const key of orderedKeys) {
  const list = grouped.get(key);
  if (!list?.length) continue;
  groups.push({ label: key ? (category.subcategories[key] ?? labelFromSlug(key)) : '全部文章', posts: list });
}
---

<Base title={category.label} description={category.description}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-14">
    <nav aria-label="面包屑" class="mb-6 flex items-center gap-2 text-sm text-ink-faint dark:text-snow-faint">
      <a href="/categories/" class="transition-colors hover:text-ink dark:hover:text-snow">分类</a>
      <span>/</span>
      <span class="text-ink-soft dark:text-snow-soft">{category.label}</span>
    </nav>

    <header class="page-header mb-12">
      <p class="eyebrow">Category / {category.mark}</p>
      <h1 class="page-title">{category.label}</h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-ink-soft dark:text-snow-soft">{category.description} · 共 {posts.length} 篇</p>
    </header>

    {
      groups.map((group) => (
        <section class="mb-12">
          <h2 class="mb-5 flex items-center gap-3 font-serif text-xl font-semibold">
            {group.label}
            <span class="font-sans text-xs font-normal text-ink-faint dark:text-snow-faint">{group.posts.length} 篇</span>
          </h2>
          <ul class="divide-y divide-line border-y border-line dark:divide-line-dark dark:border-line-dark">
            {group.posts.map((post) => <PostListItem post={post} headingLevel={3} showTags />)}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
