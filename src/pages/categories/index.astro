---
import Base from '../../layouts/Base.astro';
import { categoriesFor } from '../../data/site';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
const categories = categoriesFor(posts.map((post) => post.data.category));
const countOf = (slug: string) => posts.filter((post) => post.data.category === slug).length;
---

<Base title="分类">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-14">
    <header class="page-header mb-10">
      <p class="eyebrow">Categories / 知识地图</p>
      <h1 class="page-title">分类</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">共 {categories.length} 个分类，{posts.length} 篇文章。</p>
    </header>
    <div class="grid gap-x-10 border-b border-line dark:border-line-dark sm:grid-cols-2">
      {
        categories.map((cat, index) => (
          <a href={`/categories/${cat.slug}/`} class="group border-t border-line py-7 dark:border-line-dark">
            <div class="flex items-center justify-between gap-4">
              <span class="flex items-center gap-3 font-mono text-xs text-ink-faint dark:text-snow-faint">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span style={`color: ${cat.accent};`}>{cat.mark}</span>
              </span>
              <span class="text-xs text-ink-faint dark:text-snow-faint">{countOf(cat.slug)} 篇</span>
            </div>
            <h2 class="mt-4 flex items-center justify-between gap-4 font-serif text-2xl font-semibold transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
              {cat.label}
              <span aria-hidden="true" class="font-sans text-base font-normal text-ink-faint transition-all group-hover:translate-x-1 group-hover:text-accent dark:text-snow-faint dark:group-hover:text-accent-dark">→</span>
            </h2>
            <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft dark:text-snow-soft">{cat.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
