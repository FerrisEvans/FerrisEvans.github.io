---
import Base from '../../layouts/Base.astro';
import CardCover from '../../components/CardCover.astro';
import { CATEGORIES } from '../../data/site';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
const countOf = (slug: string) => posts.filter((p) => p.data.category === slug).length;
---

<Base title="分类">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <h1 class="font-serif text-3xl font-bold sm:text-4xl">分类</h1>
      <p class="mt-3 text-ink-soft dark:text-snow-soft">共 {CATEGORIES.length} 个分类，{posts.length} 篇文章。</p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        CATEGORIES.map((cat) => (
          <a
            href={`/categories/${cat.slug}/`}
            class="group overflow-hidden rounded-2xl border border-line bg-paper-elev shadow-[0_1px_2px_rgba(0,0,0,0.04),0_8px_24px_-12px_rgba(0,0,0,0.12)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_2px_4px_rgba(0,0,0,0.05),0_20px_40px_-16px_rgba(0,0,0,0.25)] dark:border-line-dark dark:bg-night-elev"
          >
            <CardCover category={cat.slug} class="aspect-[21/9]" />
            <div class="flex items-start justify-between gap-4 p-6">
              <div>
                <h2 class="font-serif text-xl font-bold transition-colors group-hover:text-accent dark:group-hover:text-accent-dark">
                  {cat.label}
                </h2>
                <p class="mt-2 text-sm leading-6 text-ink-soft dark:text-snow-soft">{cat.description}</p>
              </div>
              <span class="shrink-0 rounded-full bg-ink/[0.05] px-2.5 py-1 text-xs font-medium text-ink-soft dark:bg-white/10 dark:text-snow-soft">
                {countOf(cat.slug)} 篇
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
