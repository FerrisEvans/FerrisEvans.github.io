---
import { getLocale, localizePath, t } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import { Card } from 'animal-island-ui';
import CategoryBadge from './CategoryBadge.astro';
import TagChip from './TagChip.astro';
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
  showTags?: boolean;
}

const { post, headingLevel = 2, showTags = false } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const patterns = { lang: 'app-pink', 'data-structures': 'app-yellow', 'game-dev': 'app-teal', ai: 'purple' } as const;
const pattern = patterns[post.data.category as keyof typeof patterns] ?? 'default';
---

<li class="note-list-item"><Card pattern={pattern} hoverable className="note-entry">
  <div class="entry-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
    <span><Icon name="clock" size={14} />{readingTime(post)} {t(locale, "分钟")}</span>
  </div>
  <Heading class="entry-title"><a href={localizePath(postUrl(post), locale)}>{post.data.title}</a></Heading>
  {post.data.description && <p class="entry-description">{post.data.description}</p>}
  <div class="entry-bottom">
    <div class="entry-labels">
      {showTags && post.data.tags.length > 0
        ? post.data.tags.map((tag) => <TagChip tag={tag} />)
        : <CategoryBadge category={post.data.category} />}
    </div>
    <span class="entry-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  </div>
</Card></li>

<style>
  .note-list-item { min-width: 0; display: flex; }
  .note-list-item :global(.note-entry) { position: relative; display: flex; flex-direction: column; min-width: 0; width: 100%; padding: 28px; border-radius: 28px; color: var(--color-ink); }
  .entry-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; color: var(--color-ink-soft); font-size: 12px; font-weight: 600; }
  .entry-meta > span { display: inline-flex; align-items: center; gap: 5px; }
  .entry-title { margin-top: 20px; font-size: 21px; line-height: 1.55; font-weight: 800; letter-spacing: .01em; overflow-wrap: anywhere; }
  .entry-title a::after { position: absolute; z-index: 1; inset: 0; border-radius: 28px; content: ''; }
  .entry-title a:hover { color: var(--color-accent); }
  .entry-title a:focus-visible { outline: none; }
  .note-list-item:has(.entry-title a:focus-visible) { outline: 3px solid var(--color-accent); outline-offset: 4px; border-radius: 28px; }
  .entry-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 12px; margin-bottom: 24px; color: var(--color-ink-soft); font-size: 14px; font-weight: 500; line-height: 1.9; }
  .entry-bottom { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 18px; border-top: 2px dashed #a28a5c33; }
  .entry-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .entry-arrow { display: grid; place-items: center; flex: 0 0 36px; height: 36px; border-radius: 50%; background: #fffbe7c9; color: #794f27; }
  :global(.dark) .note-list-item :global(.note-entry) { background-color: #40382c; border-color: #776449; background-image: radial-gradient(#e4c88e17 1.4px, transparent 1.4px); background-size: 14px 14px; color: var(--color-snow); }
  :global(.dark) .entry-meta, :global(.dark) .entry-description { color: var(--color-snow-soft); }
  :global(.dark) .entry-bottom { border-color: #dfbd7840; }
  :global(.dark) .entry-arrow { color: #f1d495; background: #5c4d32; }
  :global(.dark) .entry-title a:hover { color: var(--color-accent-dark); }
  :global(.dark) .note-list-item:has(.entry-title a:focus-visible) { outline-color: var(--color-accent-dark); }
  @media (max-width: 640px) { .note-list-item :global(.note-entry) { padding: 24px; } .entry-title { font-size: 20px; } }
</style>
