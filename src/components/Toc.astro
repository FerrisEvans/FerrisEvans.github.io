---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  showTitle?: boolean;
}

const { headings, showTitle = true } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  toc.length > 0 && (
    <nav aria-label="目录" class="text-sm">
      {showTitle && <p class="eyebrow mb-4">On this page / 目录</p>}
      <ul class="space-y-1.5">
        {toc.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-4' : ''}>
            <a href={`#${heading.slug}`} class="toc-link py-1 pl-3 leading-5">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
