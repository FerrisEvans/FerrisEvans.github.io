---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
import IslandBrand from './IslandBrand.astro';
import { Divider } from 'animal-island-ui';
const year = new Date().getFullYear();
---
<div class="footer-wave" aria-hidden="true"><Divider type="ocean-wave" animated={false} /></div>
<footer data-pagefind-ignore class="island-footer">
  <div><a href="/lofi/" aria-label={`${SITE.title} 博客首页`}><IslandBrand /></a><span>© {year} <a href="/about/" rel="author">{SITE.author}</a> · {SITE.tagline}</span></div>
  <nav aria-label="作者联系与博客订阅">
    <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label={`${SITE.author} 的 GitHub`}><Icon name="github" size={18} /></a>
    <a href={SITE.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${SITE.author} 的 X（Twitter）`} class="social-x">𝕏</a>
    <a href={`mailto:${SITE.email}`} aria-label={`给 ${SITE.author} 发邮件`}><Icon name="mail" size={18} /></a>
    <a href="/rss.xml" aria-label={`订阅 ${SITE.title} RSS`}><Icon name="rss" size={18} /></a>
    <a class="astro-credit" href="https://astro.build" target="_blank" rel="noopener noreferrer">Built with Astro</a>
  </nav>
</footer>
<style>
  .footer-wave { margin-top:40px; }
  .island-footer { width: calc(100% - 80px); max-width: 1100px; margin: 30px auto 0; padding: 25px 0 30px; border-top: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px; font-size: 10px; color: var(--color-ink-faint); }
  :global(.dark) .island-footer { color: var(--color-snow-faint); }
  .island-footer > div { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; }
  .footer-brand { display: flex; gap: 6px; align-items: center; font-size: 15px; font-weight: 750; color: var(--island-green); }
  nav { display: flex; align-items: center; gap: 6px; }
  nav a { min-width: 36px; min-height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; }
  nav a:hover { background: var(--island-muted); }
  .social-x { font-size: 18px; }
  .astro-credit { margin-left: 8px; }
  @media(max-width: 767px) { .island-footer { width: calc(100% - 40px); } }
</style>
