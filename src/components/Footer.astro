---
import { SITE } from '../data/site';

const year = 2026;
---

<footer data-pagefind-ignore class="mt-20 border-t border-line dark:border-line-dark">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 py-8 sm:flex-row sm:px-6">
    <div class="text-center sm:text-left">
      <a href="/" class="font-serif text-lg font-bold tracking-tight">
        {SITE.title}<span class="text-accent dark:text-accent-dark">.</span>
      </a>
      <p class="mt-1.5 text-xs leading-5 text-ink-faint dark:text-snow-faint">
        © {year} {SITE.author} · Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 transition-colors hover:text-ink dark:hover:text-snow">Astro</a>
      </p>
    </div>
    <div class="flex items-center gap-1">
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="footer-icon">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.11-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.27 5.66.41.36 1.06 1.06 1.06 2.14v3.17c0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
        </svg>
      </a>
      <a href={SITE.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="footer-icon">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.4L6.47 22H3.33l7.24-8.28L1.2 2h6.4l4.42 5.85L18.9 2zm-1.1 18.1h1.72L7.75 3.8H5.9l11.9 16.3z" />
        </svg>
      </a>
      <a href={`mailto:${SITE.email}`} aria-label="Email" class="footer-icon">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </a>
      <a href="/rss.xml" aria-label="RSS" class="footer-icon">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";

  .footer-icon {
    @apply inline-flex h-10 w-10 items-center justify-center rounded-full text-ink-soft transition-colors hover:bg-ink/5 hover:text-ink dark:text-snow-soft dark:hover:bg-white/[0.07] dark:hover:text-snow;
  }
</style>
