---
import { getLocale, localizePath, t, tagLabel } from '../i18n';
const locale = getLocale(Astro.url.pathname);
/** The same original, colored folk-art icon family used by Animal Island UI. */
import { LeafIcon, BookIcon, GridIcon, TagIcon, InboxIcon, SearchIcon, ArrowRightIcon, ArrowLeftIcon, ArrowUpIcon, CodeIcon, FolderIcon, RocketIcon, SparklesIcon, CalendarIcon, ClockIcon, ChatIcon, HomeIcon, UserIcon, MailIcon, RssIcon, CatIcon, SunIcon, MoonIcon, MenuIcon, CloseIcon, BearIcon, FlowerIcon, TreeIcon, MushroomIcon, CoffeeCupIcon, ButterflyIcon, CloudIcon, HeartIcon, PencilIcon, BirdIcon, SnailIcon } from 'naive-icons';
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
const icons: Record<string, typeof LeafIcon> = {
  leaf: LeafIcon, book: BookIcon, grid: GridIcon, tag: TagIcon, archive: InboxIcon,
  search: SearchIcon, 'arrow-right': ArrowRightIcon, 'arrow-left': ArrowLeftIcon,
  'arrow-up': ArrowUpIcon, code: CodeIcon, layers: FolderIcon, game: RocketIcon,
  sparkles: SparklesIcon, calendar: CalendarIcon, clock: ClockIcon, message: ChatIcon,
  home: HomeIcon, user: UserIcon, mail: MailIcon, rss: RssIcon, github: CatIcon,
  sun: SunIcon, moon: MoonIcon, menu: MenuIcon, close: CloseIcon, bear: BearIcon,
  flower: FlowerIcon, tree: TreeIcon, mushroom: MushroomIcon, coffee: CoffeeCupIcon,
  butterfly: ButterflyIcon, cloud: CloudIcon, heart: HeartIcon, pencil: PencilIcon,
  bird: BirdIcon, snail: SnailIcon,
};
const Glyph = icons[name] ?? BookIcon;
---
<span class:list={['island-icon', className]} aria-hidden="true"><Glyph size={size} aria-hidden="true" focusable="false" /></span>
