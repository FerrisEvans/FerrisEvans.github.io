---
import type { Post } from '../utils/posts';

interface Props {
  page: {
    data: Post[];
    currentPage: number;
    lastPage: number;
    url: { current: string; prev?: string; next?: string };
  };
}

const { page } = Astro.props;
const { currentPage, lastPage } = page;

const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
const hrefFor = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
---

{
  lastPage > 1 && (
    <nav aria-label="分页" class="mt-12 flex items-center justify-center gap-2">
      {page.url.prev ? (
        <a href={page.url.prev} class="pager-link" aria-label="上一页">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </a>
      ) : (
        <span class="pager-link opacity-30" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </span>
      )}
      {pages.map((n) => (
        <a
          href={hrefFor(n)}
          aria-current={n === currentPage ? 'page' : undefined}
          class:list={[
            'pager-link min-w-9 px-2',
            n === currentPage && 'bg-ink text-paper hover:bg-ink dark:bg-snow dark:text-night dark:hover:bg-snow',
          ]}
        >
          {n}
        </a>
      ))}
      {page.url.next ? (
        <a href={page.url.next} class="pager-link" aria-label="下一页">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </a>
      ) : (
        <span class="pager-link opacity-30" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </span>
      )}
    </nav>
  )
}

<style>
  @reference "../styles/global.css";

  .pager-link {
    @apply inline-flex h-9 items-center justify-center rounded-full border border-line text-sm text-ink-soft transition-colors hover:bg-ink/5 hover:text-ink dark:border-line-dark dark:text-snow-soft dark:hover:bg-white/10 dark:hover:text-snow;
  }
</style>
