---
import Icon from './Icon.astro';
import type { Post } from '../utils/posts';

interface Props {
  page: {
    data: Post[];
    currentPage: number;
    lastPage: number;
    url: { current: string; prev?: string; next?: string };
  };
}

const { page } = Astro.props;
const { currentPage, lastPage } = page;

const pages = Array.from({ length: lastPage }, (_, i) => i + 1);
const hrefFor = (n: number) => (n === 1 ? '/lofi/' : `/page/${n}/`);
---

{
  lastPage > 1 && (
    <nav aria-label="分页" class="pagination mt-8 flex flex-col items-center justify-between gap-4 border-t border-line pt-8 dark:border-line-dark sm:flex-row">
      <p class="font-sans text-xs text-ink-faint dark:text-snow-faint">
        第 <span class="font-semibold text-ink dark:text-snow">{currentPage}</span> 页，共 <span class="font-semibold text-ink dark:text-snow">{lastPage}</span> 页
      </p>

      <div class="flex items-center gap-2">
        {page.url.prev ? (
          <a href={page.url.prev} class="pager-link blog-button gap-1.5 px-3" aria-label="上一页">
            <Icon name="arrow-left" size={18} />
            <span>上一页</span>
          </a>
        ) : (
          <span class="pager-link blog-button cursor-not-allowed gap-1.5 px-3 opacity-35" aria-hidden="true">
            <Icon name="arrow-left" size={18} />
            <span>上一页</span>
          </span>
        )}

        <div class="flex items-center gap-1.5">
          {pages.map((n) => (
            <a
              href={hrefFor(n)}
              aria-current={n === currentPage ? 'page' : undefined}
              class:list={[
                'pager-link blog-button min-w-10 px-2 font-sans',
                n === currentPage && 'border-accent/60 text-accent hover:border-accent/60 hover:text-accent dark:border-accent-dark/60 dark:text-accent-dark dark:hover:border-accent-dark/60 dark:hover:text-accent-dark',
              ]}
            >
              {n}
            </a>
          ))}
        </div>

        {page.url.next ? (
          <a href={page.url.next} class="pager-link blog-button gap-1.5 px-3" aria-label="下一页">
            <span>下一页</span>
            <Icon name="arrow-right" size={18} />
          </a>
        ) : (
          <span class="pager-link blog-button cursor-not-allowed gap-1.5 px-3 opacity-35" aria-hidden="true">
            <span>下一页</span>
            <Icon name="arrow-right" size={18} />
          </span>
        )}
      </div>
    </nav>
  )
}

<style>
  @reference "../styles/global.css";

  .pager-link {
    @apply inline-flex h-10 items-center justify-center text-xs;
  }
</style>
