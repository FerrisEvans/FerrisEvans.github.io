---
import { formatDate, getReadingTime, postUrl, type Post } from '../utils/posts';
import { categoryOf } from '../data/site';
import CardCover from './CardCover.astro';
import CategoryBadge from './CategoryBadge.astro';
import TagChip from './TagChip.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const cat = categoryOf(post.data.category);
const subLabel = post.data.subcategory ? cat.subcategories[post.data.subcategory] : undefined;
const minutes = getReadingTime(post);
const url = postUrl(post);
---

{
  featured ? (
    <article class="group relative grid overflow-hidden surface-card-interactive lg:grid-cols-12">
      <a
        href={url}
        aria-label={post.data.title}
        class="block overflow-hidden lg:col-span-6"
      >
        <CardCover
          category={post.data.category}
          subtitle={subLabel ? `${cat.enLabel} · ${subLabel}` : cat.enLabel}
          class="aspect-[16/9] h-full w-full lg:aspect-auto lg:min-h-[19rem]"
        />
      </a>

      <div class="flex flex-col justify-between gap-4 p-6 sm:p-8 lg:col-span-6">
        <div class="flex flex-col gap-3.5">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-accent dark:bg-accent-dark/15 dark:text-accent-dark">
              ★ 精选推荐
            </span>
            <CategoryBadge category={post.data.category} />
            <span class="text-xs text-ink-faint dark:text-snow-faint">·</span>
            <time class="font-mono text-xs text-ink-faint dark:text-snow-faint">
              {formatDate(post.data.pubDate)}
            </time>
            <span class="font-mono text-xs text-ink-faint dark:text-snow-faint">
              · {minutes} 分钟阅读
            </span>
          </div>

          <h2 class="font-serif text-2xl font-bold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent sm:text-3xl dark:text-snow dark:group-hover:text-accent-dark">
            <a href={url} class="after:absolute after:inset-0 after:z-0">
              {post.data.title}
            </a>
          </h2>

          {post.data.description && (
            <p class="text-sm leading-7 text-ink-soft line-clamp-3 dark:text-snow-soft">
              {post.data.description}
            </p>
          )}
        </div>

        <div class="mt-2 flex flex-wrap items-center justify-between gap-3 border-t border-line/70 pt-4 dark:border-line-dark/70">
          {post.data.tags.length > 0 ? (
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <TagChip tag={tag} />
              ))}
            </div>
          ) : (
            <span />
          )}

          <span class="inline-flex items-center gap-1 text-xs font-semibold text-accent transition-transform group-hover:translate-x-0.5 dark:text-accent-dark">
            阅读全文
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </div>
    </article>
  ) : (
    <article class="group relative flex flex-col overflow-hidden surface-card-interactive">
      <a href={url} aria-label={post.data.title} class="block overflow-hidden">
        <CardCover
          category={post.data.category}
          subtitle={subLabel ? `${cat.enLabel} · ${subLabel}` : cat.enLabel}
          class="aspect-[16/9] w-full"
        />
      </a>

      <div class="flex flex-1 flex-col justify-between gap-4 p-5 sm:p-6">
        <div class="flex flex-col gap-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <CategoryBadge category={post.data.category} />
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-ink-faint dark:text-snow-faint">
              <time>{formatDate(post.data.pubDate)}</time>
              <span>·</span>
              <span>{minutes}m</span>
            </div>
          </div>

          <h2 class="mt-0.5 font-serif text-lg font-bold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark">
            <a href={url} class="after:absolute after:inset-0 after:z-0">
              {post.data.title}
            </a>
          </h2>

          {post.data.description && (
            <p class="text-sm leading-6 text-ink-soft line-clamp-2 dark:text-snow-soft">
              {post.data.description}
            </p>
          )}
        </div>

        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 border-t border-line/60 pt-3.5 dark:border-line-dark/60">
            {post.data.tags.slice(0, 3).map((tag) => (
              <TagChip tag={tag} />
            ))}
          </div>
        )}
      </div>
    </article>
  )
}
