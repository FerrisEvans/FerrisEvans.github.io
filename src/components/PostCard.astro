---
import { formatDate, postUrl, readingTime, type Post } from '../utils/posts';
import CardCover from './CardCover.astro';
import CategoryBadge from './CategoryBadge.astro';
import TagChip from './TagChip.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const minutes = readingTime(post);
---

<article
  class:list={[
    'post-card group relative overflow-hidden rounded-xl border border-line bg-paper-elev dark:border-line-dark dark:bg-night-elev',
    featured ? 'grid md:grid-cols-[1.05fr_1fr]' : 'flex flex-col',
  ]}
>
  <CardCover
    category={post.data.category}
    class={featured ? 'aspect-[16/8] md:aspect-auto md:h-full md:min-h-80' : 'aspect-[16/9]'}
  />
  <div class:list={['flex flex-1 flex-col', featured ? 'gap-4 p-6 sm:p-8' : 'gap-3 p-5']}>
    <div class="flex flex-wrap items-center gap-3">
      <CategoryBadge category={post.data.category} />
      <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink-faint dark:text-snow-faint">
        {formatDate(post.data.pubDate)}
      </time>
      <span aria-hidden="true" class="text-xs text-ink-faint dark:text-snow-faint">·</span>
      <span class="text-xs text-ink-faint dark:text-snow-faint">{minutes} 分钟</span>
    </div>
    <h2 class:list={['font-serif font-bold leading-snug tracking-tight', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
      <a
        href={postUrl(post)}
        class="post-card-title text-ink transition-colors after:absolute after:inset-0 after:z-[1] after:content-[''] group-hover:text-accent dark:text-snow dark:group-hover:text-accent-dark"
      >
        {post.data.title}
      </a>
    </h2>
    {post.data.description && (
      <p class:list={['text-ink-soft dark:text-snow-soft', featured ? 'text-[0.9375rem] leading-7' : 'line-clamp-2 text-sm leading-6']}>
        {post.data.description}
      </p>
    )}
    <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-3">
      {post.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.slice(0, featured ? 4 : 3).map((tag) => <TagChip tag={tag} />)}
        </div>
      ) : <span />}
      {featured && (
        <span class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-accent dark:text-accent-dark">
          阅读全文
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-5-5 5 5-5 5" />
          </svg>
        </span>
      )}
    </div>
  </div>
</article>

<style>
  @reference "../styles/global.css";

  .post-card {
    box-shadow: 0 12px 30px -24px rgb(79 58 31 / 0.32);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), border-color 220ms ease, box-shadow 260ms ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-line));
    box-shadow: 0 18px 36px -26px rgb(121 85 40 / 0.36);
  }

  :global(.dark) .post-card:hover {
    border-color: color-mix(in srgb, var(--color-accent-dark) 42%, var(--color-line-dark));
    box-shadow: 0 20px 40px -26px rgb(0 0 0 / 0.6);
  }

  .post-card:has(.post-card-title:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  :global(.dark) .post-card:has(.post-card-title:focus-visible) {
    outline-color: var(--color-accent-dark);
  }

  .post-card-title:focus-visible {
    outline: none;
  }
</style>
