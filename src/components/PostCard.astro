---
import { formatDate, postUrl, readingTime, type Post } from '../utils/posts';
import CategoryBadge from './CategoryBadge.astro';
import TagChip from './TagChip.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const minutes = readingTime(post);
---

{featured ? (
  <article class="group relative py-2">
    <div class="md:grid md:grid-cols-[minmax(0,1fr)_11rem] md:gap-10">
      <div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <CategoryBadge category={post.data.category} />
          <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-ink-faint dark:text-snow-faint">
            {formatDate(post.data.pubDate)}
          </time>
          <span class="text-xs text-ink-faint dark:text-snow-faint">{minutes} 分钟阅读</span>
        </div>
        <h2 class="mt-5 max-w-3xl font-serif text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          <a
            href={postUrl(post)}
            class="transition-colors after:absolute after:inset-0 after:z-[1] after:content-[''] group-hover:text-accent dark:group-hover:text-accent-dark"
          >
            {post.data.title}
          </a>
        </h2>
        {post.data.description && (
          <p class="mt-4 max-w-2xl text-[0.9375rem] leading-7 text-ink-soft dark:text-snow-soft">
            {post.data.description}
          </p>
        )}
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 md:mt-0 md:flex-col md:items-end md:justify-between">
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-x-3 gap-y-1 md:justify-end">
            {post.data.tags.slice(0, 4).map((tag) => <TagChip tag={tag} />)}
          </div>
        )}
        <span class="inline-flex items-center gap-2 text-sm font-medium text-accent dark:text-accent-dark">
          阅读全文
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </span>
      </div>
    </div>
  </article>
) : (
  <article class="group relative py-6 sm:py-7">
    <div class="grid gap-3 sm:grid-cols-[7.5rem_minmax(0,1fr)_auto] sm:gap-x-6">
      <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs leading-6 text-ink-faint dark:text-snow-faint sm:pt-1">
        {formatDate(post.data.pubDate)}
      </time>
      <div class="min-w-0">
        <h2 class="pr-6 font-serif text-xl font-semibold leading-snug tracking-tight sm:pr-0 sm:text-2xl">
          <a
            href={postUrl(post)}
            class="transition-colors after:absolute after:inset-0 after:z-[1] after:content-[''] group-hover:text-accent dark:group-hover:text-accent-dark"
          >
            {post.data.title}
          </a>
        </h2>
        {post.data.description && (
          <p class="mt-2 line-clamp-2 max-w-2xl text-sm leading-6 text-ink-soft dark:text-snow-soft">
            {post.data.description}
          </p>
        )}
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
          <CategoryBadge category={post.data.category} />
          <span class="text-xs text-ink-faint dark:text-snow-faint">{minutes} 分钟</span>
        </div>
      </div>
      <span aria-hidden="true" class="absolute right-0 top-7 text-lg text-ink-faint transition-all duration-200 group-hover:translate-x-1 group-hover:text-accent dark:text-snow-faint dark:group-hover:text-accent-dark sm:static sm:self-center">
        →
      </span>
    </div>
  </article>
)}
