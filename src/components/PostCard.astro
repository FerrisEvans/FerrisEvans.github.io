---
import { getLocale, localizePath, t } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import { Card } from 'animal-island-ui';
import { formatDate, postUrl, readingTime, type Post } from '../utils/posts';
import CategoryBadge from './CategoryBadge.astro';
import TagChip from './TagChip.astro';
import Icon from './Icon.astro';
interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const icons: Record<string,string> = { 'programming-language': 'book', 'data-structures': 'layers', 'game-dev': 'game', ai: 'flower' };
---
<article class:list={['note-card', { 'featured-note': featured }]}>
<Card pattern={featured ? 'app-teal' : 'default'} hoverable className="note-card-body">
  <div class="note-top"><CategoryBadge category={post.data.category} /><Icon name={icons[post.data.category] ?? 'book'} size={featured ? 52 : 38} /></div>
  {featured && <p class="featured-label"><Icon name="leaf" size={18} /> {t(locale, "推荐从这里读起")}</p>}
  <h2><a href={localizePath(postUrl(post), locale)}>{post.data.title}</a></h2>
  {post.data.description && <p class="note-description">{post.data.description}</p>}
  <div class="note-tags">{post.data.tags.slice(0, featured ? 4 : 3).map(tag => <TagChip tag={tag} />)}</div>
  <div class="note-bottom"><span><Icon name="calendar" size={18} /><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time><span>· {readingTime(post)} {t(locale, "分钟")}</span></span><Icon name="arrow-right" size={23} /></div>
</Card>
</article>
<style>
 .note-card { position:relative; min-width:0; display:flex; }
 .note-card :global(.note-card-body) { display:flex; flex-direction:column; min-width:0; width:100%; padding:26px 30px; }
 .note-top { display:flex; align-items:center; justify-content:space-between; }
 h2 { font-size:22px; font-weight:700; line-height:1.6; margin:17px 0 12px; overflow-wrap:anywhere; }
 h2 a::after { content:''; position:absolute; inset:0; z-index:1; border-radius:20px; }
 h2 a:focus-visible { outline:none; }
 .note-card:has(h2 a:focus-visible) { outline:3px solid var(--island-green); outline-offset:4px; border-radius:20px; }
 .note-description { font-size:14px; line-height:1.9; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
 .note-tags { display:flex; flex-wrap:wrap; gap:8px; margin:18px 0 23px; }
 .note-card :global(.tag-chip) { color:inherit; border-color:#bbaa8d; }
 .note-card :global(.tag-chip:hover) { color:#794f27; background:#fff7de; }
 .note-bottom { display:flex; align-items:center; justify-content:space-between; gap:10px; border-top:2px dashed #c4b89e6b; padding-top:16px; margin-top:auto; font-size:12px; }
 .note-bottom > span { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
 .featured-note h2 { font-size:30px; margin-top:10px; }
 .featured-note .note-description { -webkit-line-clamp:3; }
 .featured-label { display:flex; align-items:center; gap:7px; font-size:12px; font-weight:700; margin-top:14px; }
 @media(max-width:767px) { .note-card :global(.note-card-body) { padding:22px; } h2 { font-size:21px; } .featured-note h2 { font-size:25px; } .note-bottom { font-size:11px; } }
</style>
