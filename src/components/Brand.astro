---
/** Praxis Clean Grid wordmark — path-only, no left seal, no font/script.
 *  Locked 2026-11-03 (Ferris): v1 A Clean Grid. Favicon = warm-mist ghost (separate).
 */
interface Props {
  width?: number;
  class?: string;
  label?: string;
}

const { width = 158, class: className, label = 'Praxis' } = Astro.props;
const vbW = 79;
const vbH = 16;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${vbW} ${vbH}`}
  width={width}
  height={width * vbH / vbW}
  class:list={['brand-wordmark', className]}
  role="img"
  aria-label={label}
  focusable="false"
  shape-rendering="crispEdges"
>
  <!-- PRAXIS letters (2px cells, gap 3); fill follows text color -->
  <path
    fill="currentColor"
    d="M2 1h2v2h-2zM4 1h2v2h-2zM6 1h2v2h-2zM8 1h2v2h-2zM2 3h2v2h-2zM10 3h2v2h-2zM2 5h2v2h-2zM10 5h2v2h-2zM2 7h2v2h-2zM4 7h2v2h-2zM6 7h2v2h-2zM8 7h2v2h-2zM2 9h2v2h-2zM2 11h2v2h-2zM2 13h2v2h-2zM15 1h2v2h-2zM17 1h2v2h-2zM19 1h2v2h-2zM21 1h2v2h-2zM15 3h2v2h-2zM23 3h2v2h-2zM15 5h2v2h-2zM23 5h2v2h-2zM15 7h2v2h-2zM17 7h2v2h-2zM19 7h2v2h-2zM21 7h2v2h-2zM15 9h2v2h-2zM19 9h2v2h-2zM15 11h2v2h-2zM21 11h2v2h-2zM15 13h2v2h-2zM23 13h2v2h-2zM30 1h2v2h-2zM32 1h2v2h-2zM34 1h2v2h-2zM28 3h2v2h-2zM36 3h2v2h-2zM28 5h2v2h-2zM36 5h2v2h-2zM28 7h2v2h-2zM30 7h2v2h-2zM32 7h2v2h-2zM34 7h2v2h-2zM36 7h2v2h-2zM28 9h2v2h-2zM36 9h2v2h-2zM28 11h2v2h-2zM36 11h2v2h-2zM28 13h2v2h-2zM36 13h2v2h-2zM41 1h2v2h-2zM49 1h2v2h-2zM41 3h2v2h-2zM49 3h2v2h-2zM43 5h2v2h-2zM47 5h2v2h-2zM45 7h2v2h-2zM43 9h2v2h-2zM47 9h2v2h-2zM41 11h2v2h-2zM49 11h2v2h-2zM41 13h2v2h-2zM49 13h2v2h-2zM54 1h2v2h-2zM56 1h2v2h-2zM58 1h2v2h-2zM56 3h2v2h-2zM56 5h2v2h-2zM56 7h2v2h-2zM56 9h2v2h-2zM56 11h2v2h-2zM54 13h2v2h-2zM56 13h2v2h-2zM58 13h2v2h-2zM65 1h2v2h-2zM67 1h2v2h-2zM69 1h2v2h-2zM63 3h2v2h-2zM71 3h2v2h-2zM63 5h2v2h-2zM65 7h2v2h-2zM67 7h2v2h-2zM69 7h2v2h-2zM71 9h2v2h-2zM63 11h2v2h-2zM71 11h2v2h-2zM65 13h2v2h-2zM67 13h2v2h-2zM69 13h2v2h-2z"
  />
  <!-- Trailing craft pixel (accent) -->
  <path class="active-pixel" d="M75 11h2v2h-2z" />
</svg>

<style>
  .brand-wordmark {
    display: block;
    flex-shrink: 0;
    max-width: 100%;
    height: auto;
  }
  .active-pixel {
    fill: var(--brand-accent, #966325);
  }
  :global(.dark) .active-pixel {
    fill: var(--brand-accent, #d6a45f);
  }
</style>
