---
/** Praxis Magazine Lo-fi Pixel (direction D) — locked 2026-11-03, Ferris.
 *  Brand System v5 pick. Wordmark-only — NO left seal.
 *  Hero size replaces LofiHero serif TextEffect (same letter skeleton as nav/footer).
 *  Favicon: selected/favicon.svg (transparent snow P + craft pixel).
 *  cacheVersion suggestion: praxis-5
 */
interface Props {
  size?: 'nav' | 'footer' | 'hero';
  width?: number;
  class?: string;
  label?: string;
}

const { size = 'nav', width: widthProp, class: className, label = 'Praxis' } = Astro.props;

const vbW = 117;
const vbH = 24;

const defaultWidth: Record<string, number> = {
  nav: 176,
  footer: 148,
  hero: 420,
};

const width = widthProp ?? defaultWidth[size] ?? 176;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${vbW} ${vbH}`}
  width={width}
  height={width * vbH / vbW}
  class:list={['brand-wordmark', `brand-wordmark--${size}`, className]}
  role="img"
  aria-label={label}
  focusable="false"
  shape-rendering="crispEdges"
  data-brand="magazine-lofi"
  data-brand-version="praxis-5"
>
  <!-- PRAXIS letters (Magazine Lo-fi · 8-row · cell 3 · gap 4); fill follows text color -->
  <path fill="currentColor" d="M0 0h3v3h-3zM3 0h3v3h-3zM6 0h3v3h-3zM9 0h3v3h-3zM12 0h3v3h-3zM0 3h3v3h-3zM12 3h3v3h-3zM0 6h3v3h-3zM12 6h3v3h-3zM0 9h3v3h-3zM3 9h3v3h-3zM6 9h3v3h-3zM9 9h3v3h-3zM12 9h3v3h-3zM0 12h3v3h-3zM0 15h3v3h-3zM0 18h3v3h-3zM0 21h3v3h-3zM19 0h3v3h-3zM22 0h3v3h-3zM25 0h3v3h-3zM28 0h3v3h-3zM31 0h3v3h-3zM19 3h3v3h-3zM31 3h3v3h-3zM19 6h3v3h-3zM31 6h3v3h-3zM19 9h3v3h-3zM22 9h3v3h-3zM25 9h3v3h-3zM28 9h3v3h-3zM19 12h3v3h-3zM25 12h3v3h-3zM19 15h3v3h-3zM28 15h3v3h-3zM19 18h3v3h-3zM28 18h3v3h-3zM19 21h3v3h-3zM31 21h3v3h-3zM41 0h3v3h-3zM44 0h3v3h-3zM47 0h3v3h-3zM38 3h3v3h-3zM50 3h3v3h-3zM38 6h3v3h-3zM50 6h3v3h-3zM38 9h3v3h-3zM41 9h3v3h-3zM44 9h3v3h-3zM47 9h3v3h-3zM50 9h3v3h-3zM38 12h3v3h-3zM50 12h3v3h-3zM38 15h3v3h-3zM50 15h3v3h-3zM38 18h3v3h-3zM50 18h3v3h-3zM38 21h3v3h-3zM50 21h3v3h-3zM57 0h3v3h-3zM69 0h3v3h-3zM60 3h3v3h-3zM66 3h3v3h-3zM63 6h3v3h-3zM63 9h3v3h-3zM60 12h3v3h-3zM66 12h3v3h-3zM57 15h3v3h-3zM69 15h3v3h-3zM57 18h3v3h-3zM69 18h3v3h-3zM57 21h3v3h-3zM69 21h3v3h-3zM76 0h3v3h-3zM79 0h3v3h-3zM82 0h3v3h-3zM79 3h3v3h-3zM79 6h3v3h-3zM79 9h3v3h-3zM79 12h3v3h-3zM79 15h3v3h-3zM79 18h3v3h-3zM76 21h3v3h-3zM79 21h3v3h-3zM82 21h3v3h-3zM92 0h3v3h-3zM95 0h3v3h-3zM98 0h3v3h-3zM89 3h3v3h-3zM101 3h3v3h-3zM89 6h3v3h-3zM92 9h3v3h-3zM95 9h3v3h-3zM95 12h3v3h-3zM98 12h3v3h-3zM101 15h3v3h-3zM89 18h3v3h-3zM101 18h3v3h-3zM92 21h3v3h-3zM95 21h3v3h-3zM98 21h3v3h-3z" />
  <!-- Trailing craft trailer 2×2 (accent) -->
  <path class="active-pixel" d="M111 18h3v3h-3zM114 18h3v3h-3zM111 21h3v3h-3zM114 21h3v3h-3z" />
</svg>

<style>
  .brand-wordmark {
    display: block;
    flex-shrink: 0;
    max-width: 100%;
    height: auto;
  }
  .brand-wordmark--hero {
    width: min(100%, 480px);
  }
  .active-pixel {
    fill: var(--brand-accent, #966325);
  }
  :global(.dark) .active-pixel {
    fill: var(--brand-accent, #d6a45f);
  }
</style>
