---
interface Props {
  /** Page-1 anchor for the hero “开始阅读” CTA. */
  primary?: boolean;
}

const { primary = false } = Astro.props;
---

<div
  id={primary ? 'magazine-start' : undefined}
  class:list={['scroll-mt-24', primary ? 'mt-6 sm:mt-8' : 'mt-8']}
>
  <div class="flex flex-col gap-3 rounded-xl border border-line bg-paper-elev px-3 py-3 sm:flex-row sm:items-center dark:border-line-dark dark:bg-night-elev sm:px-4">
    <a
      href="/search/"
      class="inline-flex min-h-11 flex-1 items-center gap-2 rounded-lg border border-line bg-paper px-3 text-sm text-ink-soft transition-colors hover:border-accent/40 hover:text-ink dark:border-line-dark dark:bg-night dark:text-snow-soft dark:hover:border-accent-soft/50 dark:hover:text-snow"
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      搜索实践志
      <kbd class="ml-auto hidden rounded border border-line px-1.5 py-0.5 font-sans text-[0.625rem] text-ink-faint dark:border-line-dark dark:text-snow-faint sm:inline">⌘ K</kbd>
    </a>
    <a
      href="/explore/"
      class="inline-flex min-h-11 items-center justify-center rounded-lg bg-ink px-4 text-sm font-medium text-paper transition-colors hover:bg-ink/90 dark:bg-snow dark:text-night dark:hover:bg-snow/90"
    >
      索引
    </a>
  </div>
</div>
