---
import { getLocale, localizePath } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import { categoryOf } from '../data/site';

interface Props {
  category: string;
  class?: string;
}

const { category, class: className } = Astro.props;
const cat = categoryOf(category, locale);
---

<a
  href={localizePath(`/categories/${cat.slug}/`, locale)}
  class:list={[
    'category-badge',
    className,
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background: ${cat.accent};`}></span>
  {cat.label}
</a>
