---
import { categoryOf } from '../data/site';

interface Props {
  category: string;
  class?: string;
}

const { category, class: className } = Astro.props;
const cat = categoryOf(category);
---

<a
  href={`/categories/${cat.slug}/`}
  class:list={[
    'relative z-10 inline-flex min-h-7 items-center gap-1.5 rounded-full border border-line bg-paper-elev/90 px-2.5 py-0.5 text-xs font-medium text-ink-soft backdrop-blur transition-colors hover:border-ink/20 hover:text-ink dark:border-line-dark dark:bg-night-elev/90 dark:text-snow-soft dark:hover:border-white/20 dark:hover:text-snow',
    className,
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background: ${cat.accent};`}></span>
  {cat.label}
</a>
