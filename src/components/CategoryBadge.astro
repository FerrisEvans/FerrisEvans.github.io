---
import { categoryOf } from '../data/site';

interface Props {
  category: string;
  class?: string;
}

const { category, class: className } = Astro.props;
const cat = categoryOf(category);
---

<a
  href={`/categories/${cat.slug}/`}
  class:list={[
    'relative z-10 inline-flex min-h-6 items-center gap-2 text-xs font-medium text-ink-soft transition-colors hover:text-accent dark:text-snow-soft dark:hover:text-accent-dark',
    className,
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background: ${cat.accent};`}></span>
  {cat.label}
</a>
