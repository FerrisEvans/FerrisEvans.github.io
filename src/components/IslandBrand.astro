---
interface Props {
  tagline?: boolean;
  compact?: boolean;
  class?: string;
}
const { tagline = false, compact = false, class: className } = Astro.props;
---
<span class:list={['island-brand-identity', className]}>
  <img class="island-brand-badge" src="/brand/island/mark.svg" alt={compact ? 'Praxis' : ''} width="44" height="44" />
  {!compact && <span class="island-brand-lettering"><span class="island-brand-name">Praxis</span>{tagline && <span class="island-brand-tagline">保持好奇，慢慢来</span>}</span>}
</span>
<style>
  .island-brand-identity { display:inline-flex; align-items:center; gap:10px; color:var(--color-ink,#725d42); vertical-align:middle; }
  .island-brand-badge { flex-shrink:0; width:44px; height:44px; transform:rotate(-5deg); }
  .island-brand-lettering { display:flex; flex-direction:column; gap:3px; }
  .island-brand-name { font-family:var(--font-display,"Nunito","Arial Rounded MT Bold",sans-serif); font-size:30px; line-height:1; font-weight:900; letter-spacing:-.04em; color:inherit; }
  .island-brand-tagline { font-family:var(--font-sans,sans-serif); font-size:10px; line-height:1.5; letter-spacing:.06em; color:var(--color-ink-soft,#827157); white-space:nowrap; }
  :global(.dark) .island-brand-identity { color:var(--color-snow,#fff9e8); }
  :global(.dark) .island-brand-tagline { color:var(--color-snow-soft,#ddd2bb); }
  @media(max-width:480px) { .island-brand-badge { width:38px; height:38px; } .island-brand-name { font-size:27px; } .island-brand-identity { gap:8px; } .island-brand-tagline { font-size:9px; } }
</style>
