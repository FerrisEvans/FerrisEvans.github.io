---
import { SITE } from '../data/site';
import logo from '../../public/brand/island/logo.svg?raw';
import lettering from '../../public/brand/island/lettering.svg?raw';
import mark from '../../public/brand/island/mark.svg?raw';
interface Props {
  tagline?: boolean;
  compact?: boolean;
  inline?: boolean;
  class?: string;
}
const { tagline = false, compact = false, inline = false, class: className } = Astro.props;
---
<span class:list={['island-brand-identity', { 'island-brand-inline': inline, 'island-brand-compact': compact }, className]}>
  <Fragment set:html={inline ? lettering : compact ? mark : logo} />
  {tagline && <span class="island-brand-tagline">{SITE.tagline}</span>}
</span>
<style>
  .island-brand-identity { display:inline-flex; flex-direction:column; align-items:flex-start; flex-shrink:0; gap:3px; vertical-align:middle; line-height:1; }
  .island-brand-identity :global(svg) { display:block; width:auto; height:44px; overflow:visible; }
  .island-brand-identity :global(.weijin-lettering) { fill:#76543b; }
  .island-brand-tagline { padding-left:2px; font-family:var(--font-sans,sans-serif); font-size:10px; line-height:1.5; letter-spacing:.06em; color:var(--color-ink-soft,#827157); white-space:nowrap; }
  :global(.dark) .island-brand-identity :global(.weijin-lettering) { fill:#fff3db; }
  :global(.dark) .island-brand-tagline { color:var(--color-snow-soft,#ddd2bb); }
  :global(.island-footer) .island-brand-identity :global(svg) { height:36px; }
  .island-brand-inline { display:inline-flex; vertical-align:-.38em; margin-inline:.08em; }
  .island-brand-inline :global(svg) { height:1.65em; }
  @media(max-width:480px) { .island-brand-identity:not(.island-brand-inline) :global(svg) { height:40px; } :global(.island-footer) .island-brand-identity :global(svg) { height:34px; } }
</style>
