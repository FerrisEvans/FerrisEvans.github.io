---
import { getLocale, t } from '../i18n';
const locale = getLocale(Astro.url.pathname);
import { siteFor } from '../data/site';
const SITE = siteFor(locale);
import Icon from './Icon.astro';

interface Props { articleKey: string; }
const { articleKey } = Astro.props;
const g = SITE.giscus;
---

<section id="comments" aria-labelledby="comments-heading" class="comments-note">
  <div class="comments-header">
    <span class="comments-icon"><Icon name="message" size={24} /></span>
    <div>
      <p class="island-eyebrow">{t(locale, "聊一聊")}</p>
      <h2 id="comments-heading">{t(locale, "讨论与评论")}</h2>
    </div>
    <span class="comments-provider">Giscus</span>
  </div>
  <p class="comments-intro">{t(locale, "问题、发现，或者另一种解法，都欢迎记在这里。")}</p>
  <div class="giscus"></div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={g.repo}
    data-repo-id={g.repoId}
    data-category={g.category}
    data-category-id={g.categoryId}
    data-mapping="specific"
    data-term={`posts/${articleKey}/`}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-loading="lazy"
    data-theme="preferred_color_scheme"
    data-lang={locale === 'zh' ? 'zh-CN' : 'en'}
    crossorigin="anonymous"
    async></script>
</section>

<script is:inline>
  var readyGiscusFrames = new WeakSet();
  var sentGiscusThemes = new WeakMap();
  function syncGiscusTheme() {
    var iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;
    var theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    iframe.contentWindow.postMessage({ giscus: { setConfig: { theme: theme } } }, 'https://giscus.app');
    if (readyGiscusFrames.has(iframe)) sentGiscusThemes.set(iframe, theme);
  }

  window.addEventListener('theme-changed', syncGiscusTheme);
  // A lazy iframe can finish loading before its app installs the config listener.
  // Its first message is the readiness signal; deduplicate to avoid resize loops.
  window.addEventListener('message', function (event) {
    var iframe = document.querySelector('iframe.giscus-frame');
    if (event.origin !== 'https://giscus.app' || !iframe || event.source !== iframe.contentWindow || !event.data?.giscus) return;
    readyGiscusFrames.add(iframe);
    var theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    if (sentGiscusThemes.get(iframe) !== theme) syncGiscusTheme();
  });
  var watchedGiscusFrames = new WeakSet();
  function watchGiscusFrame() {
    var iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;
    if (!watchedGiscusFrames.has(iframe)) {
      watchedGiscusFrames.add(iframe);
      iframe.addEventListener('load', syncGiscusTheme);
    }
    syncGiscusTheme();
  }
  var giscusRoot = document.querySelector('.giscus');
  if (giscusRoot) {
    new MutationObserver(watchGiscusFrame).observe(giscusRoot, { childList: true, subtree: true });
    watchGiscusFrame();
  }
</script>

<style>
  .comments-note { margin-top:34px; scroll-margin-top:100px; }
  .comments-header { display:flex; align-items:center; gap:13px; }
  .comments-icon { display:grid; place-items:center; width:46px; height:46px; flex-shrink:0; border-radius:16px; background:var(--color-paper-subtle); color:var(--color-accent); }
  .comments-header h2 { margin-top:3px; font-size:20px; font-weight:700; }
  .comments-provider { margin-left:auto; font-size:10px; color:var(--color-ink-faint); }
  .comments-intro { font-size:12px; line-height:1.8; color:var(--color-ink-soft); margin:17px 0 24px; }
  :global(.dark) .comments-icon { background:var(--color-night-subtle); color:var(--color-accent-dark); }
  :global(.dark) .comments-provider { color:var(--color-snow-faint); }
  :global(.dark) .comments-intro { color:var(--color-snow-soft); }
</style>
