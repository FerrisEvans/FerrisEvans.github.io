---
import { categoryOf } from '../data/site';

interface Props {
  category: string;
  label?: string;
  class?: string;
}

const { category, label, class: className } = Astro.props;
const cat = categoryOf(category);
const text = label ?? cat.label;
---

<div
  class:list={['card-cover relative isolate overflow-hidden', className ?? 'aspect-[16/9]']}
  style={`--category-accent: ${cat.accent};`}
  aria-hidden="true"
>
  <div class="card-cover-grid absolute inset-0"></div>
  <div class="absolute left-5 top-4 flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.18em] text-ink-soft dark:text-snow-soft">
    <span class="h-1.5 w-1.5 rounded-full" style={`background: ${cat.accent};`}></span>
    Mainloop / Notes
  </div>
  <span class="card-cover-mark absolute -right-2 bottom-0 select-none font-serif text-7xl font-bold leading-none tracking-tight sm:text-8xl">
    {cat.mark}
  </span>
  <span class="absolute bottom-4 left-5 font-serif text-sm font-bold tracking-wide text-ink-soft dark:text-snow-soft">
    {text}
  </span>
</div>

<style>
  .card-cover {
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--category-accent) 18%, transparent), transparent 46%),
      linear-gradient(135deg, color-mix(in srgb, var(--category-accent) 9%, var(--color-paper-elev)), var(--color-paper-subtle));
  }

  :global(.dark) .card-cover {
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--category-accent) 22%, transparent), transparent 46%),
      linear-gradient(135deg, color-mix(in srgb, var(--category-accent) 12%, var(--color-night-elev)), var(--color-night-subtle));
  }

  .card-cover-grid {
    background-image:
      linear-gradient(color-mix(in srgb, var(--category-accent) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--category-accent) 12%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to right, black, transparent 88%);
  }

  .card-cover-mark {
    color: color-mix(in srgb, var(--category-accent) 46%, transparent);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), color 240ms ease;
  }

  :global(.group:hover) .card-cover-mark {
    color: color-mix(in srgb, var(--category-accent) 68%, transparent);
    transform: translate(-4px, -3px);
  }
</style>
