---
import { SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import IslandBrand from './IslandBrand.astro';
const primary = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/notes/', label: '笔记', icon: 'book' },
  { href: '/categories/', label: '分类', icon: 'grid' },
  { href: '/tags/', label: '标签', icon: 'tag' },
  { href: '/archives/', label: '归档', icon: 'archive' },
  { href: '/about/', label: '关于', icon: 'user' },
];
const links = [
  ...primary,
  ...(import.meta.env.DEV ? [{ href: '/drafts/', label: '草稿', icon: 'pencil' }] : []),
];
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/'
  : href === '/notes/' ? path.startsWith('/notes/') || path.startsWith('/posts/')
  : path.startsWith(href);
---
<header class="island-nav site-header" data-pagefind-ignore>
  <div class="nav-bar">
    <a href="/" aria-label={SITE.title + ' 首页'} class="island-brand"><IslandBrand /></a>
    <nav aria-label="主导航" class="desktop-navigation nav-links">
      {primary.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={['nav-link', { 'is-active': isActive(link.href) }]}><Icon name={link.icon} size={23} /><span>{link.label}</span></a>)}
    </nav>
    <div class="nav-actions">
      <a href="/search/" class="island-icon-button blog-button" aria-label="搜索" aria-keyshortcuts="Meta+K Control+K"><Icon name="search" /></a>
      <ThemeToggle />
      <button id="menu-toggle" type="button" aria-label="打开菜单" aria-controls="mobile-menu" aria-expanded="false" class="island-icon-button blog-button mobile-menu-toggle">
        <span id="menu-icon-open"><Icon name="menu" /></span><span id="menu-icon-close" class="hidden"><Icon name="close" /></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
    <div class="mobile-menu-inner"><nav aria-label="移动导航">
      {links.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class:list={['nav-link', { 'is-active': isActive(link.href) }]}><Icon name={link.icon} /><span>{link.label}</span></a>)}
    </nav></div>
  </div>
  <noscript>
    <nav class="no-script-navigation" aria-label="页面导航">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <style>.mobile-menu-toggle, .theme-switch { display: none; }</style>
  </noscript>
</header>
<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var open = document.getElementById('menu-icon-open');
    var close = document.getElementById('menu-icon-close');
    if (!btn || !menu) return;

    function setMenu(expanded) {
      menu.dataset.open = String(expanded);
      menu.setAttribute('aria-hidden', String(!expanded));
      menu.inert = !expanded;
      btn.setAttribute('aria-expanded', String(expanded));
      btn.setAttribute('aria-label', expanded ? '关闭菜单' : '打开菜单');
      open.classList.toggle('hidden', expanded);
      close.classList.toggle('hidden', !expanded);
    }

    btn.addEventListener('click', function () {
      setMenu(btn.getAttribute('aria-expanded') !== 'true');
    });
    menu.addEventListener('click', function (event) {
      if (event.target.closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', function (event) {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        var input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
        else window.location.href = '/search/?focus=1';
        return;
      }
      if (event.key !== 'Escape') return;
      if (btn.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', function (event) {
      if (event.matches) setMenu(false);
    });
  })();
</script>
