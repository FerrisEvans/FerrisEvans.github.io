---
import { siteFor } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import IslandBrand from './IslandBrand.astro';
import LanguageIcon from './LanguageIcon.astro';
import { getLocale, localizePath, t } from '../i18n';
const locale = getLocale(Astro.url.pathname);
const site = siteFor(locale);
const languagePath = /^\/(en|zh)\//.test(Astro.url.pathname) ? Astro.url.pathname : '/';
const primary = [
  { href: '/', label: t(locale, '首页', 'Home'), icon: 'home' },
  { href: '/notes/', label: t(locale, '笔记', 'Notes'), icon: 'book' },
  { href: '/categories/', label: t(locale, '分类', 'Categories'), icon: 'grid' },
  { href: '/tags/', label: t(locale, '标签', 'Tags'), icon: 'tag' },
  { href: '/archives/', label: t(locale, '归档', 'Archives'), icon: 'archive' },
  { href: '/about/', label: t(locale, '关于', 'About'), icon: 'user' },
];
const links = [
  ...primary,
  ...(import.meta.env.DEV ? [{ href: '/drafts/', label: t(locale, '草稿', 'Drafts'), icon: 'pencil' }] : []),
];
const sceneViews: Record<string, string> = { '/notes/': 'library', '/categories/': 'categories', '/tags/': 'tags', '/about/': 'about' };
const path = Astro.url.pathname.replace(/^\/(?:en|zh)(?=\/|$)/, '') || '/';
const isActive = (href: string) => href === '/' ? path === '/'
  : href === '/notes/' ? path.startsWith('/notes/') || path.startsWith('/posts/')
  : path.startsWith(href);
---
<header class="island-nav site-header" data-pagefind-ignore>
  <div class="nav-bar">
    <a href={localizePath('/', locale)} aria-label={t(locale, `${site.title} 首页`, `${site.title} home`)} class="island-brand"><IslandBrand /></a>
    <nav aria-label={t(locale, '主导航', 'Main navigation')} class="desktop-navigation nav-links">
      {primary.map(link => <a href={localizePath(link.href, locale)} data-island-nav={sceneViews[link.href]} data-nav-tooltip aria-label={link.label} aria-current={isActive(link.href) ? 'page' : undefined} class:list={['nav-link', 'nav-icon-link', { 'is-active': isActive(link.href) }]}><Icon name={link.icon} size={25} /></a>)}
    </nav>
    <div class="nav-actions">
      <details class="nav-language">
        <summary class="island-icon-button blog-button language-toggle" data-nav-tooltip aria-label={t(locale, '选择语言', 'Choose language')} aria-controls="language-options"><LanguageIcon /></summary>
        <nav id="language-options" class="language-menu" aria-label={t(locale, '语言', 'Language')}>
          <p class="language-menu-title">{t(locale, '语言', 'Language')}</p>
          {([{ code: 'zh', lang: 'zh-CN', name: '中文', label: '切换到中文' }, { code: 'en', lang: 'en', name: 'English', label: 'Switch to English' }] as const).map(language => (
            <a href={localizePath(languagePath, language.code)} lang={language.lang} hreflang={language.lang} data-language-switch aria-label={language.label} aria-current={locale === language.code ? 'true' : undefined}>
              <span>{language.name}</span>
              <span class="language-choice-mark" aria-hidden="true">{locale === language.code && <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 5L19 7" /></svg>}</span>
            </a>
          ))}
        </nav>
      </details>
      <a href={localizePath('/search/', locale)} class="island-icon-button blog-button" data-nav-tooltip aria-label={t(locale, '搜索', 'Search')} aria-keyshortcuts="Meta+K Control+K"><Icon name="search" /></a>
      <ThemeToggle />
      <button id="menu-toggle" type="button" data-nav-tooltip aria-label={t(locale, '打开菜单', 'Open menu')} aria-controls="mobile-menu" aria-expanded="false" class="island-icon-button blog-button mobile-menu-toggle">
        <span id="menu-icon-open"><Icon name="menu" /></span><span id="menu-icon-close" class="hidden"><Icon name="close" /></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
    <div class="mobile-menu-inner"><nav aria-label={t(locale, '移动导航', 'Mobile navigation')}>
      {links.map(link => <a href={localizePath(link.href, locale)} data-island-nav={sceneViews[link.href]} aria-current={isActive(link.href) ? 'page' : undefined} class:list={['nav-link', { 'is-active': isActive(link.href) }]}><Icon name={link.icon} /><span>{link.label}</span></a>)}
    </nav></div>
  </div>
  <noscript>
    <nav class="no-script-navigation" aria-label={t(locale, '页面导航', 'Page navigation')}>{links.map(link => <a href={localizePath(link.href, locale)}>{link.label}</a>)}</nav>
    <style>.mobile-menu-toggle, .theme-switch { display: none; }</style>
  </noscript>
</header>
<script>
  import { localeForDocument, localizePath, t } from '../i18n';
  import { createIslandTooltip } from '../scripts/island/tooltip';
  (function () {
    const locale = localeForDocument();
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const open = document.getElementById('menu-icon-open');
    const close = document.getElementById('menu-icon-close');
    const languageMenu = document.querySelector<HTMLDetailsElement>('.nav-language');
    const languageToggle = languageMenu?.querySelector<HTMLElement>('summary');
    if (!btn || !menu || !open || !close) return;

    // The same paper tooltip serves the scene and icon-only navigation.
    const tooltipHost = document.createElement('div');
    tooltipHost.className = 'nav-tooltip-host';
    document.body.append(tooltipHost);
    const tooltip = createIslandTooltip(tooltipHost, { id: 'navigation-hint' });
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let described: HTMLElement | null = null;
    const hideHint = () => {
      tooltip.hide(); described?.removeAttribute('aria-describedby'); described = null;
    };
    const showHint = (target: HTMLElement) => {
      hideHint();
      if (target === languageToggle && languageMenu?.open) return;
      const rect = target.getBoundingClientRect();
      tooltip.show(target.getAttribute('aria-label') ?? '', rect.x + rect.width / 2, rect.y + rect.height / 2, reduced.matches);
      target.setAttribute('aria-describedby', 'navigation-hint'); described = target;
    };
    document.querySelectorAll<HTMLElement>('[data-nav-tooltip], .site-header .theme-switch').forEach(target => {
      target.removeAttribute('title');
      target.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') showHint(target); });
      target.addEventListener('pointerleave', hideHint);
      target.addEventListener('focus', () => showHint(target));
      target.addEventListener('blur', hideHint);
      target.addEventListener('click', hideHint);
    });
    window.addEventListener('scroll', hideHint, { passive: true });
    window.addEventListener('resize', hideHint);
    window.addEventListener('pagehide', hideHint);
    // Keep a shared article anchor or search query when changing language.
    const languageLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]')];
    const refreshLanguageLinks = () => languageLinks.forEach(link => {
      const target = new URL(link.href);
      target.search = location.search; target.hash = location.hash;
      link.href = target.href;
    });
    refreshLanguageLinks();
    languageLinks.forEach(link => link.addEventListener('click', () => {
      refreshLanguageLinks();
      if (languageMenu) languageMenu.open = false;
    }));
    window.addEventListener('hashchange', refreshLanguageLinks);
    window.addEventListener('popstate', refreshLanguageLinks);
    languageMenu?.addEventListener('toggle', () => {
      hideHint();
      if (languageMenu.open) { refreshLanguageLinks(); setMenu(false); }
    });
    document.addEventListener('pointerdown', event => {
      if (languageMenu?.open && event.target instanceof Node && !languageMenu.contains(event.target)) {
        languageMenu.open = false; hideHint();
      }
    });
    languageMenu?.addEventListener('focusout', event => {
      if (event.relatedTarget instanceof Node && !languageMenu.contains(event.relatedTarget)) languageMenu.open = false;
    });

    function setMenu(expanded: boolean) {
      if (!btn || !menu || !open || !close) return;
      hideHint();
      if (expanded && languageMenu) languageMenu.open = false;
      menu.dataset.open = String(expanded);
      menu.setAttribute('aria-hidden', String(!expanded));
      menu.inert = !expanded;
      btn.setAttribute('aria-expanded', String(expanded));
      btn.setAttribute('aria-label', expanded ? t(locale, '关闭菜单', 'Close menu') : t(locale, '打开菜单', 'Open menu'));
      open.classList.toggle('hidden', expanded);
      close.classList.toggle('hidden', !expanded);
    }

    btn.addEventListener('click', function () {
      setMenu(btn.getAttribute('aria-expanded') !== 'true');
    });
    menu.addEventListener('click', function (event) {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', function (event) {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (input) input.focus();
        else window.location.href = localizePath('/search/?focus=1', locale);
        return;
      }
      if (event.key !== 'Escape') return;
      hideHint();
      if (languageMenu?.open) {
        languageMenu.open = false; languageToggle?.focus(); hideHint(); event.preventDefault();
        return;
      }
      if (btn.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', function (event) {
      if (event.matches) setMenu(false);
    });
  })();
</script>
