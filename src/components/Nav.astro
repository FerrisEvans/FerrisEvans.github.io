---
import { SITE } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: '首页' },
  { href: '/categories/', label: '分类' },
  { href: '/tags/', label: '标签' },
  { href: '/archives/', label: '归档' },
  { href: '/about/', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header data-pagefind-ignore class="sticky top-0 z-40 border-b border-line/70 bg-paper/80 backdrop-blur-md dark:border-line-dark/70 dark:bg-night/80">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="font-serif text-xl font-bold tracking-wide text-ink dark:text-snow">
      {SITE.title}
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm transition-colors',
              isActive(link.href)
                ? 'bg-ink/5 font-medium text-ink dark:bg-white/10 dark:text-snow'
                : 'text-ink-soft hover:text-ink dark:text-snow-soft dark:hover:text-snow',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1">
      <a
        href="/search/"
        aria-label="搜索"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-soft hover:bg-ink/5 hover:text-ink dark:text-snow-soft dark:hover:bg-white/10 dark:hover:text-snow transition-colors"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </a>
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-soft hover:bg-ink/5 dark:text-snow-soft dark:hover:bg-white/10 md:hidden"
      >
        <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line/70 dark:border-line-dark/70 md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm',
              isActive(link.href)
                ? 'bg-ink/5 font-medium text-ink dark:bg-white/10 dark:text-snow'
                : 'text-ink-soft dark:text-snow-soft',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var open = document.getElementById('menu-icon-open');
    var close = document.getElementById('menu-icon-close');
    btn?.addEventListener('click', function () {
      var expanded = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(expanded));
      open.classList.toggle('hidden', expanded);
      close.classList.toggle('hidden', !expanded);
    });
  })();
</script>
