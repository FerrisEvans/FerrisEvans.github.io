---
import { getLocale, localizePath, tagLabel } from '../i18n';
const locale = getLocale(Astro.url.pathname);
interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className } = Astro.props;
---

<a
  href={localizePath(`/tags/${encodeURIComponent(tag)}/`, locale)}
  class:list={[
    'tag-chip',
    className,
  ]}
>
  #{tagLabel(tag, locale)}
</a>
