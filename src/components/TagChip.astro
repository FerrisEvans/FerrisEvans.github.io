---
interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag)}/`}
  class:list={[
    'inline-flex items-center rounded-full bg-ink/[0.05] px-2.5 py-0.5 text-xs text-ink-soft transition-colors hover:bg-ink/10 hover:text-ink dark:bg-white/10 dark:text-snow-soft dark:hover:bg-white/15 dark:hover:text-snow',
    className,
  ]}
>
  #{tag}
</a>
