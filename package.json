{
  "name": "weijin-blog",
  "type": "module",
  "version": "1.5.2",
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && tsc --noEmit",
    "build": "astro build && node scripts/island/prune-delivery.mjs && pagefind --site dist && node scripts/write-release.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "assets:model": "node scripts/island/pack-model.mjs && node scripts/island/build-manifest.mjs",
    "assets:posters": "node scripts/island/capture-posters.mjs",
    "assets:check": "node scripts/island/check-assets.mjs",
    "test:content": "node --test scripts/content.test.mjs scripts/i18n.test.mjs",
    "prebuild": "npm run check:translations && npm run test:content && npm run assets:check",
    "test": "node --test scripts/*.test.mjs scripts/island/*.test.mjs scripts/room/assets.test.mjs scripts/room/load-timings.test.mjs",
    "audit:deps": "npm audit --audit-level=low",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:authoring": "node scripts/authoring-smoke.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:guides": "node scripts/guide-browser-smoke.mjs",
    "assets:build": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/island/build_scene.py",
    "assets:brand": "node scripts/brand/build-island-brand.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "test:i18n-browser": "node scripts/i18n-browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/react": "7.1.2",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "animal-island-ui": "^3.0.0",
    "astro": "7.4.4",
    "clsx": "^2.1.1",
    "hast-util-from-html": "2.0.3",
    "katex": "0.19.1",
    "motion": "^14.9.0",
    "naive-icons": "^1.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-code-group": "1.0.1",
    "rehype-katex": "^7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/three": "^0.186.0",
    "js-yaml": "4.3.2",
    "meshoptimizer": "0.24.0",
    "pagefind": "^1.3.0",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
